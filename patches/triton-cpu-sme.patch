+struct UkernelOpsToSMELLVM
+    : public triton::cpu::impl::UkernelOpsToSMELLVMBase<
+          UkernelOpsToSMELLVM> {
+  UkernelOpsToSMELLVM() = default;
+
+  void runOnOperation() override {
+    MLIRContext *context = &getContext();
+    ModuleOp mod = getOperation();
+
+    mlir::LowerToLLVMOptions option(context);
+    TritonCPUToLLVMTypeConverter typeConverter(context, option);
+    TritonLLVMConversionTarget conversionTarget(*context);
+
+    RewritePatternSet patterns(context);
+    patterns.add<SmeBrgemmCreateConversion, SmeBrgemmExecuteConversion>(
+        typeConverter);
+
+    if (failed(applyPartialConversion(mod, conversionTarget,
+                                      std::move(patterns)))) {
+      return signalPassFailure();
+    }
+  }
+};
+
