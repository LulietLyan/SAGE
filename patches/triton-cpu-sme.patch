+
+
+def _extract_sme_plan(mod, metadata, options):
+    if options.sme_plan_mode == "off":
+        return
+    # Serialization only: all shape/layout/thread choices are C++ pass results.
+    for name in SME_PLAN_INT_ATTRS:
+        value = mod.get_int_attr(f"sme_plan.{name}")
+        if value is not None:
+            metadata[f"sme_plan_{name}"] = int(value)
+    if options.sme_plan_mode == "generic" and metadata.get("sme_plan_verified") == 0:
+        # An unmatched generic operator retains its original source and launch
+        # geometry. This is the C++ pass's explicit rejection result, not a
+        # Python GEMM policy or a substituted launch contract.
+        metadata["sme_plan_enabled"] = 0
+        metadata["sme_plan_selected_sme"] = 0
+        metadata["sme_plan_path"] = 0
+        return
+    required = ("selected_sme", "threads", "original_grid_x", "original_grid_y",
+                "original_grid_z", "grid_x", "grid_y", "grid_z")
+    if any(f"sme_plan_{name}" not in metadata for name in required):
+        raise RuntimeError("C++ GEMM planning pass did not emit a complete launch contract")
+    if metadata["sme_plan_selected_sme"] not in (0, 1):
+        raise RuntimeError("C++ GEMM planning pass emitted an invalid execution path")
+    if "sme_plan_path" in metadata and metadata["sme_plan_path"] != metadata["sme_plan_selected_sme"]:
+        raise RuntimeError("C++ GEMM path attributes disagree")
+    metadata["sme_plan_enabled"] = 1
+
+
+def _planned_sme(metadata, options):
+    if options.sme_plan_mode == "off":
+        return None
+    selected = metadata.get("sme_plan_selected_sme")
+    if selected not in (0, 1):
+        raise RuntimeError("Missing C++ GEMM execution path metadata")
+    return selected == 1
+
+
+def _env_bool(name: str, default: bool = False) -> bool:
+    value = os.getenv(name)
+    if value is None:
+        return default
+    return value.lower() in ("1", "true", "on", "yes")
+
+
+def _emit_armv9_diagnostic(status: str, selected_path: str, reason: str, target_features: str,
+                           evidence_level: str = "none", claim_guard: str = "") -> None:
+    if not _env_bool("TRITON_CPU_EMIT_ARMV9_DIAGNOSTICS", False):
+        return
+    path = os.getenv("TRITON_CPU_ARMV9_DIAGNOSTICS")
+    if not path:
+        return
+    event = {
+        "case_id": os.getenv("TRITON_CPU_ARMV9_CASE_ID", ""),
+        "target_config": os.getenv("TRITON_CPU_ARMV9_TARGET_CONFIG", ""),
+        "operator": os.getenv("TRITON_CPU_ARMV9_OPERATOR", ""),
+        "layout_state": os.getenv("TRITON_CPU_ARMV9_LAYOUT_STATE", "unknown"),
+        "tile_config": os.getenv("TRITON_CPU_ARMV9_TILE_CONFIG", "{}"),
+        "dot_index": 0,
+        "candidate_index": 0,
+        "status": status,
+        "selected_path": selected_path,
+        "reason": reason,
+        "reject_reason": "" if status == "selected" else reason,
+        "target_features": target_features,
