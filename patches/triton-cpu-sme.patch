+struct SmeBrgemmCreateConversion : public ConvertOpToLLVMPattern<BrgemmCreate> {
+  using ConvertOpToLLVMPattern<BrgemmCreate>::ConvertOpToLLVMPattern;
+
+  LogicalResult
+  matchAndRewrite(BrgemmCreate brgemmOp, OpAdaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    auto loc = brgemmOp.getLoc();
+    auto ctx = rewriter.getContext();
+    if (hasNativeF32Contract(brgemmOp)) {
+      Type resultType =
+          getTypeConverter()->convertType(brgemmOp.getResult().getType());
+      rewriter.replaceOp(
+          brgemmOp, llvmIntConstant(rewriter, loc, resultType, 0));
+      return success();
+    }
+    auto b = TritonLLVMOpBuilder(loc, rewriter);
+    auto f32TypeId = b.i64_val(0);
+
+    auto args = SmallVector<Value>{adaptor.getM(),
+                                   adaptor.getN(),
+                                   adaptor.getKK(),
+                                   adaptor.getBatchSize(),
+                                   adaptor.getLda(),
+                                   adaptor.getLdb(),
+                                   adaptor.getLdc(),
+                                   f32TypeId,
+                                   f32TypeId,
+                                   f32TypeId,
+                                   adaptor.getSkipPacking(),
+                                   adaptor.getFullM(),
+                                   adaptor.getFullN(),
+                                   adaptor.getNumTilesN()};
+    SmallVector<Type> argTypes{i64_ty, i64_ty, i64_ty, i64_ty,
+                               i64_ty, i64_ty, i64_ty, i64_ty,
+                               i64_ty, i64_ty, i1_ty,  i64_ty,
+                               i64_ty, i64_ty};
+
+    auto dispatched = LLVM::createLLVMCallOp(
+        rewriter, loc,
+        getFuncDecl(rewriter, "sme_brgemm_dispatch", argTypes,
+                    getTypeConverter()->convertType(brgemmOp.getResult().getType())),
+        args);
+
+    rewriter.replaceOp(brgemmOp, dispatched.getResult());
+    return success();
+  }
+};
+
+struct SmeBrgemmExecuteConversion
+    : public ConvertOpToLLVMPattern<BrgemmExecute> {
+  using ConvertOpToLLVMPattern<BrgemmExecute>::ConvertOpToLLVMPattern;
+
+  LogicalResult
+  matchAndRewrite(BrgemmExecute brgemmOp, OpAdaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    auto loc = brgemmOp.getLoc();
+    auto ctx = rewriter.getContext();
+
+    Value aPtr = MemRefDescriptor(adaptor.getAPtr())
+                     .bufferPtr(rewriter, loc, *getTypeConverter(),
+                                cast<MemRefType>(brgemmOp.getAPtr().getType()));
+    Value bPtr = MemRefDescriptor(adaptor.getBPtr())
+                     .bufferPtr(rewriter, loc, *getTypeConverter(),
+                                cast<MemRefType>(brgemmOp.getBPtr().getType()));
+    Value cPtr = MemRefDescriptor(adaptor.getCPtr())
+                     .bufferPtr(rewriter, loc, *getTypeConverter(),
+                                cast<MemRefType>(brgemmOp.getCPtr().getType()));
+
+    if (hasNativeF32Contract(brgemmOp)) {
+      ModuleOp module = brgemmOp->getParentOfType<ModuleOp>();
+      LLVM::LLVMFuncOp function =
+          getOrCreateNativeF32Gemm(rewriter, module, brgemmOp);
+      LLVM::CallOp::create(
+          rewriter, loc, function,
+          ValueRange{aPtr, bPtr, cPtr, adaptor.getM(), adaptor.getActiveM(),
+                     adaptor.getActiveN(), adaptor.getActiveK(),
+                     adaptor.getLdb(), adaptor.getLdc(),
+                     adaptor.getZeroAccumulator()});
+      rewriter.eraseOp(brgemmOp);
+      return success();
+    }
+
+    auto handlePtr = LLVM::IntToPtrOp::create(
+        rewriter, loc, ptr_ty(ctx), adaptor.getBrgemmKernelHash());
+
+    auto args = SmallVector<Value>{
+        handlePtr,
+        aPtr,
+        bPtr,
+        cPtr,
+        adaptor.getStepA(),
+        adaptor.getStepB(),
+        adaptor.getBlockedBsize(),
+        adaptor.getNumBatches(),
+        adaptor.getSkipPacking(),
+        adaptor.getTileId()};
+
+    auto argTypes = SmallVector<Type>{
+        ptr_ty(ctx), ptr_ty(ctx), ptr_ty(ctx), ptr_ty(ctx), i64_ty,
+        i64_ty,      i64_ty,      i64_ty,      i1_ty,      i64_ty};
+
+    auto dispatched = LLVM::createLLVMCallOp(
+        rewriter, loc,
+        getFuncDecl(rewriter, "sme_brgemm_invoke", argTypes, void_ty(ctx)),
+        args);
+
+    rewriter.replaceOp(brgemmOp, dispatched);
+    return success();
+  }
+};
