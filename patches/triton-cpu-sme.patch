diff --git a/python/test/unit/test_stages_inspection.py b/python/test/unit/test_stages_inspection.py
index 6d55f40..880be69 100644
--- a/python/test/unit/test_stages_inspection.py
+++ b/python/test/unit/test_stages_inspection.py
@@ -4,7 +4,7 @@ import os
 import pathlib
 import hashlib
 import pytest
-from triton._internal_testing import is_cuda
+from triton._internal_testing import is_cpu, is_cuda
 
 
 @pytest.mark.skipif(not is_cuda(), reason="only currently tested on CUDA")
@@ -62,3 +62,64 @@ def test_inspection(monkeypatch, fresh_knobs, tmp_path: pathlib.Path):
 
     # Check that repros match
     assert golden_repro.replace('k1', 'dummy') == hook_repro.replace('k2', 'dummy')
+
+
+@pytest.mark.cpu
+@pytest.mark.skipif(not is_cpu(), reason="only currently tested on CPU")
+def test_cpu_inspection(monkeypatch, fresh_knobs, tmp_path: pathlib.Path):
+    stage_name = 'make_ttcir'
+    curr_repro_path = tmp_path / ("repro_prefix." + stage_name + ".repro.mlir")
+    repro_path = tmp_path / "repro_prefix"
+
+    monkeypatch.setenv("TRITON_ALWAYS_COMPILE", "1")
+    monkeypatch.setenv("TRITON_REPRODUCER_PATH", str(repro_path))
+
+    inspect_stages_hook_call_count = 0
+    make_ttcir_wrapper_called = False
+
+    def get_key():
+        return pathlib.Path(__file__).read_text()
+
+    def get_hash():
+        return hashlib.sha256(get_key().encode('utf-8')).hexdigest()
+
+    def inspect_stages_hook(self=None, stages=None, options=None, language=None, capability=None):
+        if all(arg is None for arg in (stages, options, language, capability)):
+            return get_key(), get_hash()
+        nonlocal inspect_stages_hook_call_count
+        inspect_stages_hook_call_count += 1
+        assert self.target.backend == "cpu"
+        assert options.backend_name == "cpu"
+        assert language.name == "TRITON"
+        assert capability is None
+
+        original_stage = stages["ttcir"]
+
+        def make_ttcir_wrapper(src, metadata):
+            nonlocal make_ttcir_wrapper_called
+            make_ttcir_wrapper_called = True
+            return original_stage(src, metadata)
+
+        stages["ttcir"] = make_ttcir_wrapper
+
+    @triton.jit
+    def cpu_k1():
+        return
+
+    @triton.jit
+    def cpu_k2():
+        return
+
+    cpu_k1.warmup(grid=(1, ))
+    assert inspect_stages_hook_call_count == 0 and not make_ttcir_wrapper_called
+    assert os.path.exists(curr_repro_path)
+    golden_repro = curr_repro_path.read_text()
+    curr_repro_path.unlink()
+
+    fresh_knobs.runtime.add_stages_inspection_hook = inspect_stages_hook
+    cpu_k2.warmup(grid=(1, ))
+    assert inspect_stages_hook_call_count == 1 and make_ttcir_wrapper_called
+    assert os.path.exists(curr_repro_path)
+    hook_repro = curr_repro_path.read_text()
+
+    assert golden_repro.replace('cpu_k1', 'dummy') == hook_repro.replace('cpu_k2', 'dummy')
