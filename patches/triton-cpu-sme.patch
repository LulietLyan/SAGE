+bool hasFeature(llvm::StringRef features, llvm::StringRef needle) {
+  return features.split(',').first == needle || features.contains(needle);
+}
+
+bool isSupportedElemType(Type ty) {
+  return ty.isF32() || ty.isF16() || ty.isBF16() ||
+         (ty.isInteger(8) || ty.isInteger(32));
+}
+
+std::string jsonEscape(llvm::StringRef value) {
+  std::string out;
+  out.reserve(value.size() + 8);
+  for (char ch : value) {
+    if (ch == '\\' || ch == '"') {
+      out.push_back('\\');
+      out.push_back(ch);
+    } else if (ch == '\n') {
+      out += "\\n";
+    } else {
+      out.push_back(ch);
+    }
+  }
+  return out;
+}
+
+const char *envOrEmpty(const char *name) {
+  const char *value = std::getenv(name);
+  return value ? value : "";
+}
+
+std::string typeName(Type ty) {
+  if (!ty)
+    return "unknown";
+  std::string s;
+  llvm::raw_string_ostream os(s);
+  ty.print(os);
+  return os.str();
+}
+
+std::string producerName(Value value) {
+  if (Operation *producer = value.getDefiningOp())
+    return producer->getName().getStringRef().str();
+  return "block_argument";
+}
