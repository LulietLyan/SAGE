+
+bool envFlagEnabled(const char *name, bool defaultValue) {
+  const char *value = std::getenv(name);
+  if (!value || !*value)
+    return defaultValue;
+  std::string raw(value);
+  if (raw == "0" || raw == "false" || raw == "FALSE" || raw == "off" ||
+      raw == "no")
+    return false;
+  return raw == "1" || raw == "true" || raw == "TRUE" || raw == "on" ||
+         raw == "yes";
+}
+
+Value stripIndexCasts(Value val) {
+  while (auto castOp = dyn_cast_if_present<arith::IndexCastOp>(
+             val.getDefiningOp()))
+    val = castOp.getIn();
+  return val;
+}
+
+bool valueEquals(Value a, Value b) {
+  return stripIndexCasts(a) == stripIndexCasts(b);
+}
+
+std::optional<int64_t> getMulConstant(arith::MulIOp mul) {
+  if (auto cst = getConstantIntValue(mul.getRhs()))
+    return *cst;
+  if (auto cst = getConstantIntValue(mul.getLhs()))
+    return *cst;
+  return std::nullopt;
+}
+
+std::optional<int64_t> extractLdaFromRowPtr(Value rowPtr) {
+  if (auto addPtr = rowPtr.getDefiningOp<triton::AddPtrOp>()) {
+    if (auto mul = addPtr.getOffset().getDefiningOp<arith::MulIOp>()) {
+      Value mulLhs = mul.getLhs();
+      if (auto add = mulLhs.getDefiningOp<arith::AddIOp>()) {
+        if (getConstantIntValue(add.getRhs()) ||
+            getConstantIntValue(add.getLhs()))
+          return getMulConstant(mul);
+      }
+    }
+  }
+  return std::nullopt;
+}
+
+vector::MaskedLoadOp findMaskedLoadSource(Value val) {
+  if (auto fromElements = val.getDefiningOp<vector::FromElementsOp>()) {
+    for (Value elem : fromElements.getElements()) {
+      if (auto load = findMaskedLoadSource(elem))
+        return load;
+    }
+    return nullptr;
+  }
+
+  if (auto toElements = val.getDefiningOp<vector::ToElementsOp>())
+    return findMaskedLoadSource(toElements.getSource());
+
+  Value cur = val;
+  if (auto shapeCast = cur.getDefiningOp<vector::ShapeCastOp>())
+    cur = shapeCast.getSource();
+  if (auto extract = cur.getDefiningOp<vector::ExtractOp>())
+    cur = extract.getSource();
+
+  if (auto load = cur.getDefiningOp<vector::MaskedLoadOp>())
+    return load;
+
+  return nullptr;
+}
+
+std::optional<triton::AddPtrOp> findAddPtrWithOffset(Value ptr, Value offset) {
+  while (auto addPtr = ptr.getDefiningOp<triton::AddPtrOp>()) {
+    if (valueEquals(addPtr.getOffset(), offset))
+      return addPtr;
+    ptr = addPtr.getPtr();
+  }
+  return std::nullopt;
+}
+
+Value tracePtrToMemrefValue(Value memrefVal) {
+  if (auto castOp = memrefVal.getDefiningOp<triton::cpu::PtrToMemRefOp>())
+    return castOp.getSrc();
+  return nullptr;
+}
+
+std::optional<Value> findKRowOffset(Value val, Value iv) {
+  if (valueEquals(val, iv))
+    return val;
+
+  if (auto mul = val.getDefiningOp<arith::MulIOp>()) {
+    if (valueEquals(mul.getLhs(), iv) || valueEquals(mul.getRhs(), iv))
+      return val;
+    Value lhs = mul.getLhs();
+    if (auto add = lhs.getDefiningOp<arith::AddIOp>()) {
+      if (valueEquals(add.getLhs(), iv) || valueEquals(add.getRhs(), iv))
+        return val;
+    }
+  }
+
+  if (auto add = val.getDefiningOp<arith::AddIOp>()) {
+    if (valueEquals(add.getLhs(), iv) || valueEquals(add.getRhs(), iv))
+      return val;
+  }
+
+  return std::nullopt;
+}
+
+std::optional<PointerBatchPanels>
+analyzeMaskedLoadPanel(vector::MaskedLoadOp load, scf::ForOp forOp,
+                       bool isLhs, int64_t blockM, int64_t blockN,
+                       int64_t blockK) {
+  Value iv = forOp.getInductionVar();
+  Value ptr = tracePtrToMemrefValue(load.getBase());
+  if (!ptr)
+    return std::nullopt;
+
+  if (isLhs) {
+    auto kAddPtr = findAddPtrWithOffset(ptr, iv);
+    if (!kAddPtr)
+      return std::nullopt;
+
+    PointerBatchPanels info;
+    info.aRowBasePtr = kAddPtr->getPtr();
+    // First row in a block often uses a tile offset (mul(pid_m, BM*BK)) rather
+    // than row stride (mul(add(row, c), K)). Defer lda to rhs ldb when absent.
+    if (auto lda = extractLdaFromRowPtr(kAddPtr->getPtr()))
+      info.lda = *lda;
+    return info;
+  }
+
+  Value colPtr = ptr;
+  std::optional<triton::AddPtrOp> colAdd;
+  if (auto addPtr = colPtr.getDefiningOp<triton::AddPtrOp>()) {
+    if (forOp.isDefinedOutsideOfLoop(addPtr.getOffset())) {
+      colAdd = addPtr;
+      colPtr = addPtr.getPtr();
+    }
+  }
+  if (!colAdd)
+    return std::nullopt;
+
+  std::optional<Value> kOffset;
+  while (auto addPtr = colPtr.getDefiningOp<triton::AddPtrOp>()) {
+    if (auto found = findKRowOffset(addPtr.getOffset(), iv)) {
+      kOffset = *found;
+      colPtr = addPtr.getPtr();
+      break;
+    }
+    colPtr = addPtr.getPtr();
+  }
+
+  if (!kOffset)
+    return std::nullopt;
+
+  std::optional<int64_t> ldb;
+  if (auto mul = kOffset->getDefiningOp<arith::MulIOp>())
+    ldb = getMulConstant(mul);
+  else if (auto addPtr = colPtr.getDefiningOp<triton::AddPtrOp>()) {
+    if (auto mulOp = addPtr.getOffset().getDefiningOp<arith::MulIOp>())
+      ldb = getMulConstant(mulOp);
+  }
+  if (!ldb || *ldb <= 0)
+    return std::nullopt;
+
+  PointerBatchPanels info;
+  info.bGlobalPtr = colPtr;
+  info.bColOffset = colAdd->getOffset();
+  info.kOffset = *kOffset;
+  info.ldb = *ldb;
+  info.lda = *ldb;
+  return info;
+}
+
+void collectFunctionPointerRoots(Value value, scf::ForOp forOp,
+                                 llvm::DenseSet<Value> &visited,
+                                 SmallVectorImpl<Value> &roots) {
+  if (!value || !visited.insert(value).second)
+    return;
+
+  if (auto blockArg = dyn_cast<BlockArgument>(value)) {
+    if (blockArg.getOwner() == forOp.getBody()) {
+      unsigned argNumber = blockArg.getArgNumber();
+      unsigned numIvs = forOp.getNumInductionVars();
+      if (argNumber >= numIvs) {
+        collectFunctionPointerRoots(forOp.getInitArgs()[argNumber - numIvs],
+                                    forOp, visited, roots);
+      }
+      return;
+    }
+    if (isa<triton::PointerType>(blockArg.getType()) &&
+        isa<triton::FuncOp>(blockArg.getOwner()->getParentOp())) {
+      if (!llvm::is_contained(roots, value))
+        roots.push_back(value);
+    }
+    return;
+  }
+
+  if (Operation *def = value.getDefiningOp()) {
+    for (Value operand : def->getOperands())
+      collectFunctionPointerRoots(operand, forOp, visited, roots);
+  }
+}
+
+std::optional<Value> findUniqueFunctionPointerRoot(Value value,
+                                                   scf::ForOp forOp) {
+  llvm::DenseSet<Value> visited;
+  SmallVector<Value> roots;
+  collectFunctionPointerRoots(value, forOp, visited, roots);
+  if (roots.size() != 1)
+    return std::nullopt;
+  return roots.front();
+}
+
+std::optional<Value> findScaledUser(Value value, int64_t scale) {
+  std::optional<Value> result;
+  for (Operation *user : value.getUsers()) {
+    auto mul = dyn_cast<arith::MulIOp>(user);
+    if (!mul || getMulConstant(mul) != scale)
+      continue;
+    Value other = valueEquals(mul.getLhs(), value) ? mul.getRhs()
+                                                  : mul.getLhs();
+    if (!getConstantIntValue(other))
+      continue;
+    if (result && *result != mul.getResult())
+      return std::nullopt;
+    result = mul.getResult();
+  }
+  return result;
+}
+
+Value findNamedScalarArgument(triton::FuncOp func, StringRef name) {
+  for (BlockArgument arg : func.getArguments()) {
+    if (!arg.getType().isIntOrIndex())
+      continue;
+    auto nameLoc = dyn_cast<NameLoc>(arg.getLoc());
+    if (!nameLoc)
+      continue;
+    if (nameLoc.getName().getValue().equals_insensitive(name))
+      return arg;
+  }
+  return nullptr;
+}
+
+void copyExecutionSpace(PointerBatchPanels &dst,
+                        const PointerBatchPanels &src) {
+  dst.fullM = src.fullM;
+  dst.fullN = src.fullN;
+  dst.fullK = src.fullK;
+  dst.pidM = src.pidM;
+  dst.pidN = src.pidN;
+  dst.numTilesN = src.numTilesN;
+}
+
+std::optional<PointerBatchPanels>
+analyzeProgramGridRowMajorFunctionArgs(triton::cpu::DotOp op,
+                                       scf::ForOp forOp, int64_t blockM,
+                                       int64_t blockN, int64_t blockK) {
+  if (blockM <= 0 || blockN <= 0 || blockK <= 0)
+    return std::nullopt;
+
+  std::optional<int64_t> lower = getConstantIntValue(forOp.getLowerBound());
+  std::optional<int64_t> upper = getConstantIntValue(forOp.getUpperBound());
+  if (!lower || !upper || *lower != 0 || *upper <= 0 ||
+      (*upper - *lower) % blockK != 0)
+    return std::nullopt;
+
+  std::optional<Value> aRoot = findUniqueFunctionPointerRoot(op.getA(), forOp);
+  std::optional<Value> bRoot = findUniqueFunctionPointerRoot(op.getB(), forOp);
+  if (!aRoot || !bRoot || *aRoot == *bRoot)
+    return std::nullopt;
+  auto aArg = dyn_cast<BlockArgument>(*aRoot);
+  auto bArg = dyn_cast<BlockArgument>(*bRoot);
+  if (!aArg || !bArg || aArg.getArgNumber() != 0 || bArg.getArgNumber() != 1)
+    return std::nullopt;
+
+  auto func = forOp->getParentOfType<triton::FuncOp>();
+  if (!func)
+    return std::nullopt;
+
+  Value pid;
+  func.walk([&](triton::GetProgramIdOp pidOp) {
+    if (!pid && pidOp.getAxis() == triton::ProgramIDDim::X)
+      pid = pidOp.getResult();
+  });
+  if (!pid)
+    return std::nullopt;
+
+  arith::DivSIOp pidM;
+  arith::RemSIOp pidN;
+  int64_t numTilesN = 0;
+  for (Operation *user : pid.getUsers()) {
+    if (auto div = dyn_cast<arith::DivSIOp>(user)) {
+      auto divisor = getConstantIntValue(div.getRhs());
+      if (valueEquals(div.getLhs(), pid) && divisor && *divisor > 0) {
+        pidM = div;
+        numTilesN = *divisor;
+      }
+    }
+  }
+  std::optional<Value> aRowOffset;
+  std::optional<Value> bColOffset;
+  Value pidMValue;
+  Value pidNValue;
+  Value numTilesNValue;
+  if (pidM && numTilesN > 0) {
+    for (Operation *user : pid.getUsers()) {
+      if (auto rem = dyn_cast<arith::RemSIOp>(user)) {
+        auto divisor = getConstantIntValue(rem.getRhs());
+        if (valueEquals(rem.getLhs(), pid) && divisor &&
+            *divisor == numTilesN) {
+          pidN = rem;
+          break;
+        }
+      }
+    }
+    if (!pidN)
+      return std::nullopt;
+    pidMValue = pidM.getResult();
+    pidNValue = pidN.getResult();
+    numTilesNValue = pidM.getRhs();
+    aRowOffset = findScaledUser(pidMValue, blockM);
+    bColOffset = findScaledUser(pidNValue, blockN);
+  } else {
+    // A single N tile folds pid / 1 and pid % 1 into pid and zero. Require the
+    // remaining pid*blockM relation so this is still a proven row-major grid.
+    aRowOffset = findScaledUser(pid, blockM);
+    if (!aRowOffset)
+      return std::nullopt;
+    OpBuilder builder(forOp);
+    Value zero = arith::ConstantIntOp::create(builder, forOp.getLoc(),
+                                              pid.getType(), 0);
+    Value one = arith::ConstantIntOp::create(builder, forOp.getLoc(),
+                                             pid.getType(), 1);
+    pidMValue = pid;
+    pidNValue = zero;
+    numTilesNValue = one;
+    bColOffset = zero;
+    numTilesN = 1;
+  }
+  if (!aRowOffset || !bColOffset)
+    return std::nullopt;
+
+  PointerBatchPanels info;
+  info.aRowBasePtr = *aRoot;
+  info.aTileRowOffset = *aRowOffset;
+  info.bGlobalPtr = *bRoot;
+  info.bColOffset = *bColOffset;
+  info.kOffset = forOp.getInductionVar();
+  info.fullM = findNamedScalarArgument(func, "M");
+  info.fullN = findNamedScalarArgument(func, "N");
+  info.fullK = findNamedScalarArgument(func, "K");
+  info.pidM = pidMValue;
+  info.pidN = pidNValue;
+  info.numTilesN = numTilesNValue;
+  if (!info.fullM || !info.fullN || !info.fullK)
+    return std::nullopt;
+  info.lda = *upper - *lower;
+  info.ldb = numTilesN * blockN;
+  return info;
+}
+
+std::optional<PointerBatchPanels>
+analyzeFixedRowMajorFunctionArgs(triton::cpu::DotOp op, scf::ForOp forOp,
+                                 int64_t blockM, int64_t blockN,
+                                 int64_t blockK) {
+  if (blockM <= 0 || blockN <= 0 || blockK <= 0)
+    return std::nullopt;
+
+  std::optional<int64_t> lower = getConstantIntValue(forOp.getLowerBound());
+  std::optional<int64_t> upper = getConstantIntValue(forOp.getUpperBound());
+  if (!lower || !upper || *lower != 0 || *upper <= 0 ||
+      (*upper - *lower) % blockK != 0)
+    return std::nullopt;
+
+  bool hasProgramId = false;
+  if (auto func = forOp->getParentOfType<triton::FuncOp>())
+    func.walk([&](triton::GetProgramIdOp) { hasProgramId = true; });
+  if (hasProgramId)
+    return std::nullopt;
+
+  std::optional<Value> aRoot = findUniqueFunctionPointerRoot(op.getA(), forOp);
+  std::optional<Value> bRoot = findUniqueFunctionPointerRoot(op.getB(), forOp);
+  if (!aRoot || !bRoot || *aRoot == *bRoot)
+    return std::nullopt;
+
+  auto aArg = dyn_cast<BlockArgument>(*aRoot);
+  auto bArg = dyn_cast<BlockArgument>(*bRoot);
+  if (!aArg || !bArg || aArg.getArgNumber() != 0 || bArg.getArgNumber() != 1)
+    return std::nullopt;
+
+  PointerBatchPanels info;
+  info.aRowBasePtr = *aRoot;
+  info.bGlobalPtr = *bRoot;
+  info.bColOffset = forOp.getLowerBound();
+  info.kOffset = forOp.getInductionVar();
+  OpBuilder builder(forOp);
+  info.fullM =
+      arith::ConstantIndexOp::create(builder, forOp.getLoc(), blockM);
+  info.fullN =
+      arith::ConstantIndexOp::create(builder, forOp.getLoc(), blockN);
+  info.fullK = forOp.getUpperBound();
+  info.lda = *upper - *lower;
+  info.ldb = blockN;
+  return info;
+}
+
+} // namespace
+
+bool kloopFusionEnabled() {
+  return envFlagEnabled("TRITON_CPU_ARMV9_KLOOP_FUSION", true);
+}
+
+bool kloopPointerBatchEnabled() {
+  return envFlagEnabled("TRITON_CPU_ARMV9_KLOOP_POINTER_BATCH", true);
+}
+
+scf::ForOp getParentKLoopForDot(triton::cpu::DotOp op) {
+  return dyn_cast<scf::ForOp>(op->getParentOp());
+}
+
+bool isSupportedKLoopStep(scf::ForOp forOp, int64_t blockK) {
+  auto step = getConstantIntValue(forOp.getStep());
+  return step.has_value() && *step == blockK;
+}
+
+std::optional<PointerBatchPanels>
+analyzePointerBatchPanels(triton::cpu::DotOp op, scf::ForOp forOp,
+                          int64_t blockM, int64_t blockN, int64_t blockK) {
+  auto lhsLoad = findMaskedLoadSource(op.getA());
+  auto rhsLoad = findMaskedLoadSource(op.getB());
+  if (!lhsLoad || !rhsLoad) {
+    if (auto grid = analyzeProgramGridRowMajorFunctionArgs(
+            op, forOp, blockM, blockN, blockK))
+      return grid;
+    return analyzeFixedRowMajorFunctionArgs(op, forOp, blockM, blockN,
+                                            blockK);
+  }
+
+  auto lhsInfo =
+      analyzeMaskedLoadPanel(lhsLoad, forOp, /*isLhs=*/true, blockM, blockN,
+                             blockK);
+  if (!lhsInfo) {
+    if (auto grid = analyzeProgramGridRowMajorFunctionArgs(
+            op, forOp, blockM, blockN, blockK))
+      return grid;
+    return analyzeFixedRowMajorFunctionArgs(op, forOp, blockM, blockN,
+                                            blockK);
+  }
+
+  auto rhsInfo =
+      analyzeMaskedLoadPanel(rhsLoad, forOp, /*isLhs=*/false, blockM, blockN,
+                             blockK);
+  if (!rhsInfo) {
+    if (auto grid = analyzeProgramGridRowMajorFunctionArgs(
+            op, forOp, blockM, blockN, blockK))
+      return grid;
+    return analyzeFixedRowMajorFunctionArgs(op, forOp, blockM, blockN,
+                                            blockK);
+  }
+
+  PointerBatchPanels info = *lhsInfo;
+  info.bGlobalPtr = rhsInfo->bGlobalPtr;
+  info.bColOffset = rhsInfo->bColOffset;
+  info.kOffset = rhsInfo->kOffset;
+  info.ldb = rhsInfo->ldb;
+  if (info.lda <= 0)
+    info.lda = info.ldb;
+  auto grid = analyzeProgramGridRowMajorFunctionArgs(op, forOp, blockM, blockN,
+                                                     blockK);
+  if (grid)
+    copyExecutionSpace(info, *grid);
+  else {
+    auto fixed = analyzeFixedRowMajorFunctionArgs(op, forOp, blockM, blockN,
+                                                  blockK);
+    if (!fixed)
+      return std::nullopt;
+    copyExecutionSpace(info, *fixed);
+  }
+  return info;
+}
+
+} // namespace cpu
+} // namespace triton
+} // namespace mlir
