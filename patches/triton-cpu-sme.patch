+  if (!read_metadata_int(metadata, "sme_plan_enabled", false, &enabled))
+    return false;
+  if (!enabled)
+    return true;
+  if (!read_metadata_int(metadata, "sme_plan_b_global_pad", false, &pad))
+    return false;
+  if (!pad)
+    return true;
+  int64_t verified = 0, selected_sme = 0, local_pad = 0, n = 0, k = 0;
+  if (!read_metadata_int(metadata, "sme_plan_verified", true, &verified) ||
+      !read_metadata_int(metadata, "sme_plan_selected_sme", true, &selected_sme) ||
+      !read_metadata_int(metadata, "sme_plan_b_panel_pad", true, &local_pad) ||
+      !read_metadata_int(metadata, "sme_plan_n", true, &n) ||
+      !read_metadata_int(metadata, "sme_plan_k", true, &k))
+    return false;
+  if (pad != 16 || local_pad != 0 || verified != 1 || selected_sme != 1 ||
+      n <= 0 || k <= 0 || selected_threads <= 0 || !*b_pointer) {{
+    PyErr_SetString(PyExc_ValueError, "Invalid compiler global-B padding contract");
+    return false;
+  }}
+  constexpr uint64_t maximum_workspace_bytes = 256ULL * 1024 * 1024;
+  const uint64_t width = uint64_t(n) + uint64_t(pad);
+  if (uint64_t(n) > UINT64_MAX - uint64_t(pad) ||
+      uint64_t(k) > UINT64_MAX / width ||
+      uint64_t(k) * width > maximum_workspace_bytes / sizeof(float)) {{
+    PyErr_SetString(PyExc_ValueError, "Compiler global-B workspace exceeds 256 MiB or overflows");
+    return false;
+  }}
+  const size_t elements = size_t(uint64_t(k) * width);
+  workspace.last_requested_bytes = uint64_t(elements) * sizeof(float);
+  if (workspace.storage.size() < elements) {{
+    const auto start = std::chrono::steady_clock::now();
+    try {{
+      // Reserve exactly the requested growth before resize; steady calls reuse
+      // the workspace and never allocate, free, or initialize padding columns.
+      workspace.storage.reserve(elements);
+      workspace.storage.resize(elements);
+    }} catch (const std::bad_alloc &) {{
+      PyErr_NoMemory();
+      return false;
+    }}
+    workspace.last_growth_ns = uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now() - start).count());
+    workspace.total_growth_ns += workspace.last_growth_ns;
+    ++workspace.growth_count;
+  }}
+  float *target = workspace.storage.data();
+  const float *source = static_cast<const float *>(*b_pointer);
+  const size_t valid_row_bytes = size_t(n) * sizeof(float);
+  workspace.last_copied_bytes = uint64_t(k) * uint64_t(valid_row_bytes);
+  workspace.last_copy_team_size = 1;
+  if (selected_threads == 1) {{
+    for (int64_t row = 0; row < k; ++row)
+      std::memcpy(target + uint64_t(row) * width,
+                  source + uint64_t(row) * uint64_t(n), valid_row_bytes);
+  }} else {{
+    // The primary caller participates in this team. The implicit barrier ends
+    // all B copies before the following GEMM parallel region can start.
+#ifdef _OPENMP
+#pragma omp parallel for schedule(static) num_threads(selected_threads)
+#endif
+    for (int64_t row = 0; row < k; ++row) {{
+#ifdef _OPENMP
+      if (row == 0)
+        workspace.last_copy_team_size = omp_get_num_threads();
+#endif
+      std::memcpy(target + uint64_t(row) * width,
+                  source + uint64_t(row) * uint64_t(n), valid_row_bytes);
+    }}
+  }}
+  // Only this invocation's native pointer is replaced. Application tensors,
+  // logical N, and the output C pointer/stride remain unchanged.
+  *b_pointer = target;
+  ++workspace.copy_call_count;
+  return true;
+}}
+
+static PyObject *workspace_info(PyObject *, PyObject *) {{
+  const GlobalBWorkspace &workspace = global_b_workspace;
+  return Py_BuildValue("{{sK,sK,sK,sK,sK,sK,sK,si}}",
+      "last_growth_ns", (unsigned long long)workspace.last_growth_ns,
+      "total_growth_ns", (unsigned long long)workspace.total_growth_ns,
+      "growth_count", (unsigned long long)workspace.growth_count,
+      "last_requested_bytes", (unsigned long long)workspace.last_requested_bytes,
+      "capacity_bytes", (unsigned long long)(workspace.storage.capacity() * sizeof(float)),
+      "last_copied_bytes", (unsigned long long)workspace.last_copied_bytes,
+      "copy_call_count", (unsigned long long)workspace.copy_call_count,
+      "last_copy_team_size", workspace.last_copy_team_size);
+}}
