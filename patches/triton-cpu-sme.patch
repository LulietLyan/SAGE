 VecLib = cpu.passes.ttcpuir.VecLib
 Ukernels = cpu.passes.ttcpuir.Ukernels
 
+ARMV9_MODES = ("off", "probe", "force", "auto")
+DOT_FALLBACKS = ("nanokernel", "fma", "generic")
+SME_PLAN_MODES = ("off", "generic", "sme-fixed", "ours", "calibration-probe")
+SME_PLAN_INT_ATTRS = (
+    "verified", "path", "selected_sme", "threads", "m", "n", "k", "lda", "ldb", "ldc",
+    "block_m", "block_n", "block_k",
+    "k_strip", "a_pack_vector4", "b_panel_pad", "b_global_pad", "reuse_m",
