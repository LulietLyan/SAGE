+static Value tracePtrToMemrefValue(Value memrefVal) {
+  if (auto castOp = memrefVal.getDefiningOp<triton::cpu::PtrToMemRefOp>())
+    return castOp.getSrc();
+  return nullptr;
+}
+
+static bool isLikelyCPtr(Value ptr) {
+  if (auto blockArg = dyn_cast<BlockArgument>(ptr))
+    return blockArg.getArgNumber() == 2;
+  return false;
+}
+
+static bool tracesToCPtr(Value ptr) {
+  while (auto addPtr = ptr.getDefiningOp<triton::AddPtrOp>()) {
+    if (isLikelyCPtr(addPtr.getPtr()))
+      return true;
+    ptr = addPtr.getPtr();
+  }
+  return isLikelyCPtr(ptr);
+}
+
+static std::optional<Value> extractLdcFromRowStore(vector::MaskedStoreOp store) {
+  Value ptr = tracePtrToMemrefValue(store.getBase());
+  if (!ptr)
+    return std::nullopt;
+  if (auto colAdd = ptr.getDefiningOp<triton::AddPtrOp>()) {
+    // Scalarization folds a fixed 32-column row address to `c + 32`.
+    // The second row's constant offset is therefore the row stride itself.
+    if (auto offset = getConstantIntValue(colAdd.getOffset()); offset && *offset > 0)
+      return colAdd.getOffset();
+    ptr = colAdd.getPtr();
+  }
+  if (auto rowAdd = ptr.getDefiningOp<triton::AddPtrOp>()) {
+    if (auto mul = rowAdd.getOffset().getDefiningOp<arith::MulIOp>()) {
+      if (isa<arith::ConstantOp>(mul.getRhs().getDefiningOp()))
+        return mul.getRhs();
+      if (isa<arith::ConstantOp>(mul.getLhs().getDefiningOp()))
+        return mul.getLhs();
+    }
+  }
+  return std::nullopt;
+}
+
+static std::optional<DirectOutputTile>
+findDirectOutputTile(scf::ForOp forOp, int resIdx, int64_t blockM,
+                     int64_t blockN, Value knownLdc = nullptr) {
+  Value loopRes = forOp.getResult(resIdx);
+  SmallVector<std::pair<int64_t, vector::MaskedStoreOp>> rowStores;
+  SmallVector<Operation *> epilogueOps;
+  bool seenLoop = false;
+
+  for (Operation &op : forOp->getBlock()->getOperations()) {
+    if (&op == forOp.getOperation()) {
+      seenLoop = true;
+      continue;
+    }
+    if (!seenLoop)
+      continue;
+    if (isa<triton::ReturnOp>(op))
+      break;
+
+    auto store = dyn_cast<vector::MaskedStoreOp>(&op);
+    if (!store)
+      continue;
+
+    auto extract = store.getValueToStore().getDefiningOp<vector::ExtractOp>();
+    if (!extract || extract.getSource() != loopRes)
+      continue;
+    {
+      auto srcTy = dyn_cast<VectorType>(extract.getSource().getType());
+      if (!srcTy || srcTy.getRank() != 2 || srcTy.getDimSize(0) != blockM ||
+          srcTy.getDimSize(1) != blockN)
+        continue;
+    }
+
+    int64_t rowIdx = rowStores.size();
+    if (extract) {
+      ArrayRef<int64_t> staticPos = extract.getStaticPosition();
+      if (staticPos.size() == 1)
+        rowIdx = staticPos[0];
+      else if (!extract.getDynamicPosition().empty()) {
+        if (auto cst = extract.getDynamicPosition()[0]
+                           .getDefiningOp<arith::ConstantOp>())
+          rowIdx = cast<IntegerAttr>(cst.getValue()).getInt();
+      }
+    }
+
+    rowStores.emplace_back(rowIdx, store);
+    epilogueOps.push_back(store);
+    if (extract)
+      epilogueOps.push_back(extract);
+  }
+
+  if (rowStores.size() != static_cast<size_t>(blockM)) {
+    rowStores.clear();
+    epilogueOps.clear();
+    if (auto func = forOp->getParentOfType<triton::FuncOp>()) {
+      for (Block &block : func.getBody()) {
+        for (Operation &op : block) {
+          auto store = dyn_cast<vector::MaskedStoreOp>(&op);
+          if (!store)
+            continue;
+          auto extract = store.getValueToStore().getDefiningOp<vector::ExtractOp>();
+          if (!extract || extract.getSource() != loopRes)
+            continue;
+          auto srcTy = dyn_cast<VectorType>(extract.getSource().getType());
+          if (!srcTy || srcTy.getRank() != 2 || srcTy.getDimSize(0) != blockM ||
+              srcTy.getDimSize(1) != blockN)
+            continue;
+          int64_t rowIdx = rowStores.size();
+          ArrayRef<int64_t> staticPos = extract.getStaticPosition();
+          if (staticPos.size() == 1)
+            rowIdx = staticPos[0];
+          rowStores.emplace_back(rowIdx, store);
+          epilogueOps.push_back(store);
+          epilogueOps.push_back(extract);
+        }
+      }
+    }
+  }
+
+  if (rowStores.size() != static_cast<size_t>(blockM))
+    return std::nullopt;
+
+  llvm::sort(rowStores, [](auto &a, auto &b) { return a.first < b.first; });
+
+  vector::MaskedStoreOp firstStore = rowStores[0].second;
+
+  std::optional<Value> ldcVal = knownLdc;
+  if (!ldcVal && rowStores.size() > 1)
+    ldcVal = extractLdcFromRowStore(rowStores[1].second);
+  if (!ldcVal)
+    ldcVal = extractLdcFromRowStore(rowStores[0].second);
+  if (!ldcVal)
+    return std::nullopt;
+
+  DirectOutputTile info;
+  info.anchorStore = firstStore;
+  info.lastStore = rowStores.back().second;
+  info.ldc = *ldcVal;
+  info.epilogueOps = std::move(epilogueOps);
+  return info;
+}
