+// Planning is performed by the framework before lowering. Keep the selected
+// values in IR so the compiler cache, generated code and evidence agree.
+// Legacy callers without these attributes retain their environment controls.
+static Attribute inheritedPlanAttr(Operation *anchor, StringRef name) {
+  for (Operation *op = anchor; op; op = op->getParentOp())
+    if (Attribute attr = op->getAttr(name))
+      return attr;
+  return {};
+}
+
+static std::optional<int64_t> inheritedPlanInt(Operation *anchor,
+                                               StringRef name) {
+  Attribute attr = inheritedPlanAttr(anchor, name);
+  if (auto boolean = dyn_cast_or_null<BoolAttr>(attr))
+    return boolean.getValue() ? 1 : 0;
+  if (auto integer = dyn_cast_or_null<IntegerAttr>(attr))
+    return integer.getInt();
+  return std::nullopt;
