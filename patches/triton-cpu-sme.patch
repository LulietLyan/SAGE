+         bool(inheritedPlanAttr(anchor, "sme_plan.b_panel_pad")) ||
+         bool(inheritedPlanAttr(anchor, "sme_plan.a_pack_vector4")) ||
+         bool(inheritedPlanAttr(anchor, "sme_plan.reuse_m"));
