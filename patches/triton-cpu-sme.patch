@@ -0,0 +1,70 @@
+// RUN: env TRITON_CPU_ENABLE_SME_DOT=1 TRITON_CPU_SME_JIT=1 triton-opt %s -triton-cpu-ukernels-to-sme-llvm | FileCheck %s
+
+// CHECK-DAG: llvm.func @sme_brgemm_dispatch
+// CHECK-DAG: llvm.func @sme_brgemm_invoke
+// CHECK-NOT: llvm.func internal @__triton_cpu_sme_gemm_f32
+
+module {
+  tt.func @explicit_fallback_m16(%a: memref<?x16xf32>,
+                           %b: memref<16x32xf32, strided<[32, 1]>>,
+                           %c: memref<16x32xf32, strided<[32, 1]>>) {
+    %c32_i64 = arith.constant 32 : i64
+    %c16_i64 = arith.constant 16 : i64
+    %c1 = arith.constant 1 : index
+    %c16 = arith.constant 16 : index
+    %c32 = arith.constant 32 : index
+    %c1024 = arith.constant 1024 : index
+    %c2048 = arith.constant 2048 : index
+    %c0 = arith.constant 0 : index
+    %true = arith.constant true
+    %false = arith.constant false
