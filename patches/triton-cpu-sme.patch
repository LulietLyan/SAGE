index 0000000..6f0f36b
--- /dev/null
+++ b/test/TritonCPU/sme-gemm-candidate-metadata.mlir
@@ -0,0 +1,26 @@
+// RUN: triton-opt %s -triton-cpu-convert-dot-to-sme="target-features=+sme" | FileCheck %s
+
+// CHECK-LABEL: @candidate_metadata
+// CHECK: triton_cpu.dot
+// CHECK-SAME: triton_cpu.sme_gemm_candidate = {
+// CHECK-SAME: block_k = 16 : i64
+// CHECK-SAME: block_m = 32 : i64
+// CHECK-SAME: block_n = 32 : i64
+// CHECK-SAME: eligibility = "candidate"
+// CHECK-SAME: global_k = "unknown"
+// CHECK-SAME: global_m = "unknown"
+// CHECK-SAME: global_n = "unknown"
+// CHECK-SAME: kind = "gemm"
+// CHECK-SAME: lhs_dtype = "f32"
+// CHECK-SAME: program_grid = "unknown"
+// CHECK-SAME: rhs_dtype = "f32"
+
+module {
+  tt.func @candidate_metadata(%a: vector<32x16xf32>,
+                              %b: vector<16x32xf32>,
+                              %c: vector<32x32xf32>) {
+    %result = triton_cpu.dot %a, %b, %c, inputPrecision = ieee :
+        vector<32x16xf32> * vector<16x32xf32> -> vector<32x32xf32>
+    tt.return
+  }
+}
