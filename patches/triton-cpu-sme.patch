+LLVM::LLVMFuncOp getOrCreateNativeF32Gemm(
+    ConversionPatternRewriter &rewriter, ModuleOp module,
+    Operation *planAnchor) {
+  const int64_t reuseMTiles = bPanelReuseMTiles(planAnchor);
+  std::string functionName = "__triton_cpu_sme_gemm_f32";
+  if (reuseMTiles == 0)
+    functionName += "_b_reuse_all_m";
+  else if (reuseMTiles > 1)
+    functionName += "_b_reuse_m" + std::to_string(reuseMTiles * 32);
+  if (auto fn = module.lookupSymbol<LLVM::LLVMFuncOp>(functionName))
+    return fn;
+
+  MLIRContext *ctx = rewriter.getContext();
+  Location loc = UnknownLoc::get(ctx);
+  Type ptrType = LLVM::LLVMPointerType::get(ctx);
+  Type i1Type = rewriter.getI1Type();
+  Type i32Type = rewriter.getI32Type();
+  Type i64Type = rewriter.getI64Type();
+  Type f32Type = rewriter.getF32Type();
+  Type voidType = LLVM::LLVMVoidType::get(ctx);
+  auto predType = VectorType::get({4}, i1Type, {true});
+  auto vecType = VectorType::get({4}, f32Type, {true});
+
+  // packed A, B, C, packed lda, active M/N/K, ldb, ldc, zeroAccumulator.
+  SmallVector<Type> argumentTypes{ptrType, ptrType, ptrType, i64Type, i64Type,
+                                  i64Type, i64Type, i64Type, i64Type, i1Type};
+  auto functionType =
+      LLVM::LLVMFunctionType::get(voidType, argumentTypes, false);
+
+  ConversionPatternRewriter::InsertionGuard guard(rewriter);
+  rewriter.setInsertionPointToStart(module.getBody());
+  auto function = LLVM::LLVMFuncOp::create(
+      rewriter, loc, functionName, functionType, LLVM::Linkage::Internal);
+  function->setAttr(SymbolTable::getVisibilityAttrName(),
+                    rewriter.getStringAttr("private"));
+  function.setArmLocallyStreaming(true);
+  function.setArmNewZa(true);
+  function.setNoUnwind(true);
+  function.setNoInline(true);
+  function.setVscaleRangeAttr(LLVM::VScaleRangeAttr::get(
+      ctx, rewriter.getI32IntegerAttr(4), rewriter.getI32IntegerAttr(4)));
+  function.setTargetFeaturesAttr(
+      LLVM::TargetFeaturesAttr::get(ctx, "+neon,+sme"));
+
+  Block *entry = function.addEntryBlock(rewriter);
+  auto appendBlock = [&](ArrayRef<Type> argumentTypes) {
+    auto *block = new Block();
+    function.getBody().push_back(block);
+    for (Type type : argumentTypes)
+      block->addArgument(type, loc);
+    return block;
+  };
+
+  Block *groupHeader = appendBlock({i64Type});
+  Block *nHeader = appendBlock({i64Type, i64Type});
+  Block *mHeader = appendBlock({i64Type, i64Type, i64Type});
+  Block *tileStart = appendBlock({i64Type, i64Type});
+  Block *tileZero = appendBlock({i64Type, i64Type});
+  Block *load0Header = appendBlock({i64Type, i64Type, i64Type});
+  Block *load0Body = appendBlock({i64Type, i64Type, i64Type});
+  Block *load1Header = appendBlock({i64Type, i64Type, i64Type});
+  Block *load1Body = appendBlock({i64Type, i64Type, i64Type});
+  Block *kMainHeader = appendBlock({i64Type, i64Type, i64Type});
+  Block *kMainBody = appendBlock({i64Type, i64Type, i64Type});
+  Block *kTailHeader = appendBlock({i64Type, i64Type, i64Type});
+  Block *kTailBody = appendBlock({i64Type, i64Type, i64Type});
+  Block *store0Header = appendBlock({i64Type, i64Type, i64Type});
+  Block *store0Body = appendBlock({i64Type, i64Type, i64Type});
+  Block *store1Header = appendBlock({i64Type, i64Type, i64Type});
+  Block *store1Body = appendBlock({i64Type, i64Type, i64Type});
+  Block *mLatch = appendBlock({i64Type, i64Type, i64Type});
+  Block *nLatch = appendBlock({i64Type, i64Type});
+  Block *groupLatch = appendBlock({i64Type});
+  Block *exit = appendBlock({});
+
+  Value a = entry->getArgument(0);
+  Value b = entry->getArgument(1);
+  Value c = entry->getArgument(2);
+  Value packedLda = entry->getArgument(3);
+  Value activeM = entry->getArgument(4);
+  Value activeN = entry->getArgument(5);
+  Value activeK = entry->getArgument(6);
+  Value ldb = entry->getArgument(7);
+  Value ldc = entry->getArgument(8);
+  Value zeroAccumulator = entry->getArgument(9);
+
+  auto whilelo = getFuncDecl(
+      rewriter, "llvm.aarch64.sve.whilelo.nxv4i1.i64",
+      {i64Type, i64Type}, predType);
+  auto ld1 = getFuncDecl(rewriter, "llvm.aarch64.sve.ld1.nxv4f32.p0",
+                         {predType, ptrType}, vecType);
+  auto zero = getFuncDecl(rewriter, "llvm.aarch64.sme.zero", {i32Type},
+                          voidType);
+  auto mopa = getFuncDecl(
+      rewriter, "llvm.aarch64.sme.mopa.nxv4f32",
+      {i32Type, predType, predType, vecType, vecType}, voidType);
+  auto ld1w = getFuncDecl(
+      rewriter, "llvm.aarch64.sme.ld1w.horiz.p0",
+      {predType, ptrType, i32Type, i32Type}, voidType);
+  auto st1w = getFuncDecl(
+      rewriter, "llvm.aarch64.sme.st1w.horiz.p0",
+      {predType, ptrType, i32Type, i32Type}, voidType);
+
+  rewriter.setInsertionPointToStart(entry);
+  Value zaMask = llvmIntConstant(rewriter, loc, i32Type, 255);
+  Value zeroI64 = llvmIntConstant(rewriter, loc, i64Type, 0);
+  Value oneI64 = llvmIntConstant(rewriter, loc, i64Type, 1);
+  Value c4 = llvmIntConstant(rewriter, loc, i64Type, 4);
+  Value c16 = llvmIntConstant(rewriter, loc, i64Type, 16);
+  Value c32 = llvmIntConstant(rewriter, loc, i64Type, 32);
+  Value c31 = llvmIntConstant(rewriter, loc, i64Type, 31);
+  Value numMTiles = LLVM::UDivOp::create(
+      rewriter, loc, LLVM::AddOp::create(rewriter, loc, activeM, c31), c32);
+  Value numNTiles = LLVM::UDivOp::create(
+      rewriter, loc, LLVM::AddOp::create(rewriter, loc, activeN, c31), c32);
+  Value reuseGroupSize;
+  if (reuseMTiles == 0) {
+    reuseGroupSize = numMTiles;
+  } else {
+    reuseGroupSize =
+        llvmIntConstant(rewriter, loc, i64Type, reuseMTiles);
+  }
+  LLVM::BrOp::create(rewriter, loc, ValueRange{zeroI64}, groupHeader);
+
+  rewriter.setInsertionPointToStart(groupHeader);
+  Value groupBase = groupHeader->getArgument(0);
+  Value hasGroup = LLVM::ICmpOp::create(
+      rewriter, loc, LLVM::ICmpPredicate::ult, groupBase, numMTiles);
+  LLVM::CondBrOp::create(rewriter, loc, hasGroup, nHeader,
+                         ValueRange{groupBase, zeroI64}, exit, ValueRange{});
+
+  rewriter.setInsertionPointToStart(nHeader);
+  groupBase = nHeader->getArgument(0);
+  Value nTile = nHeader->getArgument(1);
+  Value hasNTile = LLVM::ICmpOp::create(
+      rewriter, loc, LLVM::ICmpPredicate::ult, nTile, numNTiles);
+  LLVM::CondBrOp::create(rewriter, loc, hasNTile, mHeader,
+                         ValueRange{groupBase, nTile, groupBase}, groupLatch,
+                         ValueRange{groupBase});
+
+  rewriter.setInsertionPointToStart(mHeader);
+  groupBase = mHeader->getArgument(0);
+  nTile = mHeader->getArgument(1);
+  Value mTile = mHeader->getArgument(2);
+  Value groupEnd =
+      LLVM::AddOp::create(rewriter, loc, groupBase, reuseGroupSize);
+  Value beforeGroupEnd = LLVM::ICmpOp::create(
+      rewriter, loc, LLVM::ICmpPredicate::ult, mTile, groupEnd);
+  Value beforeMEnd = LLVM::ICmpOp::create(
+      rewriter, loc, LLVM::ICmpPredicate::ult, mTile, numMTiles);
+  Value hasMTile =
+      LLVM::AndOp::create(rewriter, loc, beforeGroupEnd, beforeMEnd);
+  LLVM::CondBrOp::create(rewriter, loc, hasMTile, tileStart,
+                         ValueRange{mTile, nTile}, nLatch,
+                         ValueRange{groupBase, nTile});
+
+  rewriter.setInsertionPointToStart(tileStart);
+  mTile = tileStart->getArgument(0);
+  nTile = tileStart->getArgument(1);
+  // Always clear ZA first. Non-zero accumulator strips then reload C into ZA so
+  // fmopa can continue a streamed K panel without a second output tile.
+  LLVM::CallOp::create(rewriter, loc, zero, ValueRange{zaMask});
+  LLVM::CondBrOp::create(rewriter, loc, zeroAccumulator, tileZero,
+                         ValueRange{mTile, nTile}, load0Header,
+                         ValueRange{mTile, nTile, zeroI64});
+
+  rewriter.setInsertionPointToStart(tileZero);
+  mTile = tileZero->getArgument(0);
+  nTile = tileZero->getArgument(1);
+  LLVM::BrOp::create(rewriter, loc, ValueRange{mTile, nTile, zeroI64},
+                     kMainHeader);
+
+  auto emitLoadPair = [&](Value loadM, Value loadN, Value slice,
+                          int64_t leftTile, int64_t rightTile,
+                          int64_t rowHalf) {
+    Value mOffset = LLVM::MulOp::create(rewriter, loc, loadM, c32);
+    Value nOffset = LLVM::MulOp::create(rewriter, loc, loadN, c32);
+    Value globalRow = LLVM::AddOp::create(rewriter, loc, mOffset, slice);
+    if (rowHalf)
+      globalRow = LLVM::AddOp::create(rewriter, loc, globalRow, c16);
+    Value outputOffset = LLVM::AddOp::create(
+        rewriter, loc, LLVM::MulOp::create(rewriter, loc, globalRow, ldc),
+        nOffset);
+    Value outputPtr = LLVM::GEPOp::create(rewriter, loc, ptrType, f32Type, c,
+                                         outputOffset);
+    Value rightPtr = LLVM::GEPOp::create(rewriter, loc, ptrType, f32Type,
+                                        outputPtr, c16);
+    Value nOffset1 = LLVM::AddOp::create(rewriter, loc, nOffset, c16);
+    Value pred0 = LLVM::CallOp::create(
+                      rewriter, loc, whilelo, ValueRange{nOffset, activeN})
+                      .getResult();
+    Value pred1 = LLVM::CallOp::create(
+                      rewriter, loc, whilelo, ValueRange{nOffset1, activeN})
+                      .getResult();
+    Value sliceI32 = LLVM::TruncOp::create(rewriter, loc, i32Type, slice);
+    LLVM::CallOp::create(
+        rewriter, loc, ld1w,
+        ValueRange{pred0, outputPtr,
+                   llvmIntConstant(rewriter, loc, i32Type, leftTile),
+                   sliceI32});
+    LLVM::CallOp::create(
+        rewriter, loc, ld1w,
+        ValueRange{pred1, rightPtr,
+                   llvmIntConstant(rewriter, loc, i32Type, rightTile),
+                   sliceI32});
+  };
+
+  rewriter.setInsertionPointToStart(load0Header);
+  mTile = load0Header->getArgument(0);
+  nTile = load0Header->getArgument(1);
+  Value loadSlice = load0Header->getArgument(2);
+  Value loadMOffset = LLVM::MulOp::create(rewriter, loc, mTile, c32);
+  Value loadGlobalRow =
+      LLVM::AddOp::create(rewriter, loc, loadMOffset, loadSlice);
+  Value hasLoadSlice0 = LLVM::ICmpOp::create(
+      rewriter, loc, LLVM::ICmpPredicate::ult, loadSlice, c16);
+  Value hasLoadRow0 = LLVM::ICmpOp::create(
+      rewriter, loc, LLVM::ICmpPredicate::ult, loadGlobalRow, activeM);
+  Value loadRow0 =
+      LLVM::AndOp::create(rewriter, loc, hasLoadSlice0, hasLoadRow0);
+  LLVM::CondBrOp::create(rewriter, loc, loadRow0, load0Body,
+                         ValueRange{mTile, nTile, loadSlice}, load1Header,
+                         ValueRange{mTile, nTile, zeroI64});
+
+  rewriter.setInsertionPointToStart(load0Body);
+  mTile = load0Body->getArgument(0);
+  nTile = load0Body->getArgument(1);
+  loadSlice = load0Body->getArgument(2);
+  emitLoadPair(mTile, nTile, loadSlice, 0, 1, 0);
+  Value nextLoadSlice = LLVM::AddOp::create(rewriter, loc, loadSlice, oneI64);
+  LLVM::BrOp::create(rewriter, loc,
+                     ValueRange{mTile, nTile, nextLoadSlice}, load0Header);
+
+  rewriter.setInsertionPointToStart(load1Header);
+  mTile = load1Header->getArgument(0);
+  nTile = load1Header->getArgument(1);
+  loadSlice = load1Header->getArgument(2);
+  loadMOffset = LLVM::MulOp::create(rewriter, loc, mTile, c32);
+  loadGlobalRow = LLVM::AddOp::create(
+      rewriter, loc, LLVM::AddOp::create(rewriter, loc, loadMOffset, c16),
+      loadSlice);
+  Value hasLoadSlice1 = LLVM::ICmpOp::create(
+      rewriter, loc, LLVM::ICmpPredicate::ult, loadSlice, c16);
+  Value hasLoadRow1 = LLVM::ICmpOp::create(
+      rewriter, loc, LLVM::ICmpPredicate::ult, loadGlobalRow, activeM);
+  Value loadRow1 =
+      LLVM::AndOp::create(rewriter, loc, hasLoadSlice1, hasLoadRow1);
+  LLVM::CondBrOp::create(rewriter, loc, loadRow1, load1Body,
+                         ValueRange{mTile, nTile, loadSlice}, kMainHeader,
+                         ValueRange{mTile, nTile, zeroI64});
+
+  rewriter.setInsertionPointToStart(load1Body);
+  mTile = load1Body->getArgument(0);
+  nTile = load1Body->getArgument(1);
+  loadSlice = load1Body->getArgument(2);
+  emitLoadPair(mTile, nTile, loadSlice, 2, 3, 1);
+  nextLoadSlice = LLVM::AddOp::create(rewriter, loc, loadSlice, oneI64);
+  LLVM::BrOp::create(rewriter, loc,
+                     ValueRange{mTile, nTile, nextLoadSlice}, load1Header);
+
+  auto emitKUpdate = [&](Value updateM, Value updateN, Value k) {
+    Value mOffset = LLVM::MulOp::create(rewriter, loc, updateM, c32);
+    Value nOffset = LLVM::MulOp::create(rewriter, loc, updateN, c32);
+    Value mOffset1 = LLVM::AddOp::create(rewriter, loc, mOffset, c16);
+    Value nOffset1 = LLVM::AddOp::create(rewriter, loc, nOffset, c16);
+    Value predA0 = LLVM::CallOp::create(
+                       rewriter, loc, whilelo, ValueRange{mOffset, activeM})
+                       .getResult();
+    Value predA1 = LLVM::CallOp::create(
+                       rewriter, loc, whilelo, ValueRange{mOffset1, activeM})
+                       .getResult();
+    Value predB0 = LLVM::CallOp::create(
+                       rewriter, loc, whilelo, ValueRange{nOffset, activeN})
+                       .getResult();
+    Value predB1 = LLVM::CallOp::create(
+                       rewriter, loc, whilelo, ValueRange{nOffset1, activeN})
+                       .getResult();
+    Value aRowOffset = LLVM::AddOp::create(
+        rewriter, loc, LLVM::MulOp::create(rewriter, loc, k, packedLda),
+        mOffset);
+    Value a0Ptr = LLVM::GEPOp::create(rewriter, loc, ptrType, f32Type, a,
+                                     aRowOffset);
+    Value a1Ptr = LLVM::GEPOp::create(rewriter, loc, ptrType, f32Type, a0Ptr,
+                                     c16);
+    Value bRowOffset = LLVM::AddOp::create(
+        rewriter, loc, LLVM::MulOp::create(rewriter, loc, k, ldb), nOffset);
+    Value b0Ptr = LLVM::GEPOp::create(rewriter, loc, ptrType, f32Type, b,
+                                     bRowOffset);
+    Value b1Ptr = LLVM::GEPOp::create(rewriter, loc, ptrType, f32Type, b0Ptr,
+                                     c16);
+    Value a0 = LLVM::CallOp::create(rewriter, loc, ld1,
+                                    ValueRange{predA0, a0Ptr})
+                   .getResult();
+    Value a1 = LLVM::CallOp::create(rewriter, loc, ld1,
+                                    ValueRange{predA1, a1Ptr})
+                   .getResult();
+    Value b0 = LLVM::CallOp::create(rewriter, loc, ld1,
+                                    ValueRange{predB0, b0Ptr})
+                   .getResult();
+    Value b1 = LLVM::CallOp::create(rewriter, loc, ld1,
+                                    ValueRange{predB1, b1Ptr})
+                   .getResult();
+    SmallVector<Value> lhs{a0, a0, a1, a1};
+    SmallVector<Value> rhs{b0, b1, b0, b1};
+    SmallVector<Value> predM{predA0, predA0, predA1, predA1};
+    SmallVector<Value> predN{predB0, predB1, predB0, predB1};
+    for (int64_t tile = 0; tile < 4; ++tile) {
+      Value tileId = llvmIntConstant(rewriter, loc, i32Type, tile);
+      LLVM::CallOp::create(rewriter, loc, mopa,
+                           ValueRange{tileId, predM[tile], predN[tile],
+                                      lhs[tile], rhs[tile]});
+    }
+  };
+
+  rewriter.setInsertionPointToStart(kMainHeader);
+  mTile = kMainHeader->getArgument(0);
+  nTile = kMainHeader->getArgument(1);
+  Value k = kMainHeader->getArgument(2);
+  Value kPlus4 = LLVM::AddOp::create(rewriter, loc, k, c4);
+  Value hasMainK = LLVM::ICmpOp::create(
+      rewriter, loc, LLVM::ICmpPredicate::ule, kPlus4, activeK);
+  LLVM::CondBrOp::create(rewriter, loc, hasMainK, kMainBody,
+                         ValueRange{mTile, nTile, k}, kTailHeader,
+                         ValueRange{mTile, nTile, k});
+
+  rewriter.setInsertionPointToStart(kMainBody);
+  mTile = kMainBody->getArgument(0);
+  nTile = kMainBody->getArgument(1);
+  k = kMainBody->getArgument(2);
+  for (int64_t unroll = 0; unroll < 4; ++unroll) {
+    Value ku = k;
+    if (unroll)
+      ku = LLVM::AddOp::create(
+          rewriter, loc, k,
+          llvmIntConstant(rewriter, loc, i64Type, unroll));
+    emitKUpdate(mTile, nTile, ku);
+  }
+  LLVM::BrOp::create(rewriter, loc, ValueRange{mTile, nTile, kPlus4},
+                     kMainHeader);
+
+  rewriter.setInsertionPointToStart(kTailHeader);
+  mTile = kTailHeader->getArgument(0);
+  nTile = kTailHeader->getArgument(1);
+  k = kTailHeader->getArgument(2);
+  Value hasTailK = LLVM::ICmpOp::create(
+      rewriter, loc, LLVM::ICmpPredicate::ult, k, activeK);
+  LLVM::CondBrOp::create(rewriter, loc, hasTailK, kTailBody,
+                         ValueRange{mTile, nTile, k}, store0Header,
+                         ValueRange{mTile, nTile, zeroI64});
+
+  rewriter.setInsertionPointToStart(kTailBody);
+  mTile = kTailBody->getArgument(0);
+  nTile = kTailBody->getArgument(1);
+  k = kTailBody->getArgument(2);
+  emitKUpdate(mTile, nTile, k);
+  Value nextK = LLVM::AddOp::create(rewriter, loc, k, oneI64);
+  LLVM::BrOp::create(rewriter, loc, ValueRange{mTile, nTile, nextK},
+                     kTailHeader);
+
+  auto emitStorePair = [&](Value storeM, Value storeN, Value slice,
+                           int64_t leftTile, int64_t rightTile,
+                           int64_t rowHalf) {
+    Value mOffset = LLVM::MulOp::create(rewriter, loc, storeM, c32);
+    Value nOffset = LLVM::MulOp::create(rewriter, loc, storeN, c32);
+    Value globalRow = LLVM::AddOp::create(rewriter, loc, mOffset, slice);
+    if (rowHalf)
+      globalRow = LLVM::AddOp::create(rewriter, loc, globalRow, c16);
+    Value outputOffset = LLVM::AddOp::create(
+        rewriter, loc, LLVM::MulOp::create(rewriter, loc, globalRow, ldc),
+        nOffset);
+    Value outputPtr = LLVM::GEPOp::create(rewriter, loc, ptrType, f32Type, c,
+                                         outputOffset);
+    Value rightPtr = LLVM::GEPOp::create(rewriter, loc, ptrType, f32Type,
+                                        outputPtr, c16);
+    Value nOffset1 = LLVM::AddOp::create(rewriter, loc, nOffset, c16);
+    Value pred0 = LLVM::CallOp::create(
+                      rewriter, loc, whilelo, ValueRange{nOffset, activeN})
+                      .getResult();
+    Value pred1 = LLVM::CallOp::create(
+                      rewriter, loc, whilelo, ValueRange{nOffset1, activeN})
+                      .getResult();
+    Value sliceI32 = LLVM::TruncOp::create(rewriter, loc, i32Type, slice);
+    LLVM::CallOp::create(
+        rewriter, loc, st1w,
+        ValueRange{pred0, outputPtr,
+                   llvmIntConstant(rewriter, loc, i32Type, leftTile),
+                   sliceI32});
+    LLVM::CallOp::create(
+        rewriter, loc, st1w,
+        ValueRange{pred1, rightPtr,
+                   llvmIntConstant(rewriter, loc, i32Type, rightTile),
+                   sliceI32});
+  };
+
+  rewriter.setInsertionPointToStart(store0Header);
+  mTile = store0Header->getArgument(0);
+  nTile = store0Header->getArgument(1);
+  Value slice = store0Header->getArgument(2);
+  Value mOffset = LLVM::MulOp::create(rewriter, loc, mTile, c32);
+  Value globalRow = LLVM::AddOp::create(rewriter, loc, mOffset, slice);
+  Value hasSlice0 = LLVM::ICmpOp::create(
+      rewriter, loc, LLVM::ICmpPredicate::ult, slice, c16);
+  Value hasRow0 = LLVM::ICmpOp::create(
+      rewriter, loc, LLVM::ICmpPredicate::ult, globalRow, activeM);
+  Value storeRow0 = LLVM::AndOp::create(rewriter, loc, hasSlice0, hasRow0);
+  LLVM::CondBrOp::create(rewriter, loc, storeRow0, store0Body,
+                         ValueRange{mTile, nTile, slice}, store1Header,
+                         ValueRange{mTile, nTile, zeroI64});
+
+  rewriter.setInsertionPointToStart(store0Body);
+  mTile = store0Body->getArgument(0);
+  nTile = store0Body->getArgument(1);
+  slice = store0Body->getArgument(2);
+  emitStorePair(mTile, nTile, slice, 0, 1, 0);
+  Value nextSlice = LLVM::AddOp::create(rewriter, loc, slice, oneI64);
+  LLVM::BrOp::create(rewriter, loc,
+                     ValueRange{mTile, nTile, nextSlice}, store0Header);
+
+  rewriter.setInsertionPointToStart(store1Header);
+  mTile = store1Header->getArgument(0);
+  nTile = store1Header->getArgument(1);
+  slice = store1Header->getArgument(2);
+  mOffset = LLVM::MulOp::create(rewriter, loc, mTile, c32);
+  globalRow = LLVM::AddOp::create(
+      rewriter, loc, LLVM::AddOp::create(rewriter, loc, mOffset, c16), slice);
+  Value hasSlice1 = LLVM::ICmpOp::create(
+      rewriter, loc, LLVM::ICmpPredicate::ult, slice, c16);
+  Value hasRow1 = LLVM::ICmpOp::create(
+      rewriter, loc, LLVM::ICmpPredicate::ult, globalRow, activeM);
+  Value storeRow1 = LLVM::AndOp::create(rewriter, loc, hasSlice1, hasRow1);
+  LLVM::CondBrOp::create(rewriter, loc, storeRow1, store1Body,
+                         ValueRange{mTile, nTile, slice}, mLatch,
+                         ValueRange{groupBase, mTile, nTile});
+
+  rewriter.setInsertionPointToStart(store1Body);
+  mTile = store1Body->getArgument(0);
+  nTile = store1Body->getArgument(1);
+  slice = store1Body->getArgument(2);
+  emitStorePair(mTile, nTile, slice, 2, 3, 1);
+  nextSlice = LLVM::AddOp::create(rewriter, loc, slice, oneI64);
+  LLVM::BrOp::create(rewriter, loc,
+                     ValueRange{mTile, nTile, nextSlice}, store1Header);
+
+  rewriter.setInsertionPointToStart(mLatch);
+  groupBase = mLatch->getArgument(0);
+  mTile = mLatch->getArgument(1);
+  nTile = mLatch->getArgument(2);
+  Value nextMTile = LLVM::AddOp::create(rewriter, loc, mTile, oneI64);
+  LLVM::BrOp::create(rewriter, loc,
+                     ValueRange{groupBase, nTile, nextMTile}, mHeader);
+
+  rewriter.setInsertionPointToStart(nLatch);
+  groupBase = nLatch->getArgument(0);
+  nTile = nLatch->getArgument(1);
+  Value nextNTile = LLVM::AddOp::create(rewriter, loc, nTile, oneI64);
+  LLVM::BrOp::create(rewriter, loc,
+                     ValueRange{groupBase, nextNTile}, nHeader);
+
+  rewriter.setInsertionPointToStart(groupLatch);
+  groupBase = groupLatch->getArgument(0);
+  Value nextGroup =
+      LLVM::AddOp::create(rewriter, loc, groupBase, reuseGroupSize);
+  LLVM::BrOp::create(rewriter, loc, ValueRange{nextGroup}, groupHeader);
+
+  rewriter.setInsertionPointToStart(exit);
+  LLVM::ReturnOp::create(rewriter, loc, ValueRange{});
+  return function;
+}
