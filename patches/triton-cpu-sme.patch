+DictionaryAttr buildGemmMetadata(cpu::DotOp op,
+                                 const SmeDotCandidate &candidate) {
+  MLIRContext *ctx = op.getContext();
+  Builder builder(ctx);
+  int64_t programIdCount = 0;
+  if (auto func = op->getParentOfType<triton::FuncOp>())
+    func.walk([&](triton::GetProgramIdOp) { ++programIdCount; });
+
+  NamedAttrList fields;
+  fields.append("kind", builder.getStringAttr("gemm"));
+  fields.append("eligibility",
+                builder.getStringAttr(candidate.supported ? "candidate"
+                                                          : "fallback"));
+  fields.append("block_m", builder.getI64IntegerAttr(candidate.m));
+  fields.append("block_n", builder.getI64IntegerAttr(candidate.n));
+  fields.append("block_k", builder.getI64IntegerAttr(candidate.k));
+  fields.append("global_m", builder.getStringAttr("unknown"));
+  fields.append("global_n", builder.getStringAttr("unknown"));
+  fields.append("global_k", builder.getStringAttr("unknown"));
+  fields.append("program_grid", builder.getStringAttr("unknown"));
+  fields.append("program_id_count",
+                builder.getI64IntegerAttr(programIdCount));
+  fields.append("lhs_dtype", builder.getStringAttr(typeName(candidate.lhsElemTy)));
+  fields.append("rhs_dtype", builder.getStringAttr(typeName(candidate.rhsElemTy)));
+  fields.append("acc_dtype", builder.getStringAttr(typeName(candidate.accElemTy)));
+  fields.append("lhs_producer", builder.getStringAttr(producerName(op.getA())));
+  fields.append("rhs_producer", builder.getStringAttr(producerName(op.getB())));
+  fields.append("acc_producer", builder.getStringAttr(producerName(op.getC())));
+  fields.append("pointer_strides",
+                builder.getStringAttr("preserve-in-brgemm-operands"));
+  fields.append("operand_layout",
+                builder.getStringAttr("resolve-from-producers-before-lowering"));
+  fields.append("mask_boundary",
+                builder.getStringAttr("resolve-from-transfer-producers"));
+  if (!candidate.supported)
+    fields.append("reject_reason",
+                  builder.getStringAttr(candidate.rejectReason.str()));
+  return DictionaryAttr::get(ctx, fields);
+}
+
+void appendDiagnosticEvent(int64_t dotIndex, const SmeDotCandidate &candidate,
+                           llvm::StringRef targetFeatures) {
+  const char *enabled = std::getenv("TRITON_CPU_EMIT_ARMV9_DIAGNOSTICS");
+  const char *path = std::getenv("TRITON_CPU_ARMV9_DIAGNOSTICS");
+  if (!enabled || llvm::StringRef(enabled) == "0" || !path || !*path)
+    return;
+  std::error_code ec;
+  llvm::raw_fd_ostream os(path, ec, llvm::sys::fs::OF_Append);
+  if (ec) {
+    llvm::errs() << "TRITON_CPU_ARMV9: failed to write diagnostics " << path
+                 << ": " << ec.message() << "\n";
+    return;
+  }
+  const bool callPathEnabled =
+      llvm::StringRef(envOrEmpty("TRITON_CPU_ENABLE_SME_CALL_PATH")) == "1" ||
+      llvm::StringRef(envOrEmpty("TRITON_CPU_ENABLE_SME_CALL_PATH")).equals_insensitive("true");
+  const bool selectedHookEnabled =
+      llvm::StringRef(envOrEmpty("TRITON_CPU_ARMV9_ENABLE_SELECTED_HOOK")) == "1" ||
+      llvm::StringRef(envOrEmpty("TRITON_CPU_ARMV9_ENABLE_SELECTED_HOOK")).equals_insensitive("true");
+  std::string status = candidate.supported ? "selected" : "rejected";
+  std::string selectedPath =
+      candidate.supported
+          ? (callPathEnabled ? "sme-call-path" : "sme-probe-only")
+          : "generic";
+  if (candidate.supported && selectedHookEnabled && !callPathEnabled)
+    selectedPath = "sme-hook-selected";
+  std::string reason =
+      candidate.supported
+          ? (callPathEnabled
+                 ? std::string("candidate satisfies SME call-path boundary; external call replacement remains diagnostic")
+                 : selectedHookEnabled
+                 ? std::string("candidate selected by Part 13 SME lowering hook; fallback lowering still generates executable code")
+                 : std::string("candidate satisfies SME predicate but call path is disabled; probe-only evidence"))
+          : candidate.rejectReason.str().str();
+  std::string evidenceLevel =
+      candidate.supported
+          ? (callPathEnabled || selectedHookEnabled ? "selected-lowering-hook"
+                                                    : "source-present")
+          : "none";
+  std::string claimGuard =
+      candidate.supported
+          ? "selected-lowering hook is not assembly-present or dispatch-confirmed SME acceleration"
+          : "rejected candidate cannot support an SME acceleration claim";
+  std::string elemTypes = typeName(candidate.lhsElemTy) + "," +
+                          typeName(candidate.rhsElemTy) + "," +
+                          typeName(candidate.accElemTy);
+  std::string tileShape = std::to_string(candidate.m) + "x" +
+                          std::to_string(candidate.n) + "x" +
+                          std::to_string(candidate.k);
+  os << "{\"case_id\":\"" << jsonEscape(envOrEmpty("TRITON_CPU_ARMV9_CASE_ID"))
+     << "\",\"target_config\":\""
+     << jsonEscape(envOrEmpty("TRITON_CPU_ARMV9_TARGET_CONFIG"))
+     << "\",\"operator\":\""
+     << jsonEscape(envOrEmpty("TRITON_CPU_ARMV9_OPERATOR"))
+     << "\",\"layout_state\":\""
+     << jsonEscape(envOrEmpty("TRITON_CPU_ARMV9_LAYOUT_STATE"))
+     << "\",\"tile_config\":\""
+     << jsonEscape(envOrEmpty("TRITON_CPU_ARMV9_TILE_CONFIG"))
+     << "\",\"dot_index\":" << dotIndex << ",\"candidate_index\":"
+     << dotIndex << ",\"status\":\"" << status
+     << "\",\"eligibility_status\":\""
+     << (candidate.supported ? "eligible" : "rejected")
+     << "\",\"selected_path\":\"" << selectedPath << "\",\"reason\":\""
+     << jsonEscape(reason) << "\",\"reject_reason\":\""
+     << jsonEscape(candidate.supported ? "" : reason) << "\",\"element_types\":\""
+     << jsonEscape(elemTypes) << "\",\"tile_shape\":\""
+     << jsonEscape(tileShape) << "\",\"target_features\":\""
+     << jsonEscape(targetFeatures) << "\",\"call_target\":\""
+     << (candidate.supported && callPathEnabled ? "part7_sme_gemm_f32_packed" : "")
+     << "\",\"fallback_policy\":\""
+     << jsonEscape(envOrEmpty("TRITON_CPU_ARMV9_ALLOW_FALLBACK"))
+     << "\",\"selected_hook_enabled\":"
+     << (selectedHookEnabled ? "true" : "false")
+     << ",\"evidence_level\":\"" << evidenceLevel
+     << "\",\"claim_guard\":\"" << jsonEscape(claimGuard)
+     << "\",\"source\":\"pass_log\"}\n";
+}
+
+SmeDotCandidate classify(cpu::DotOp op, llvm::StringRef targetFeatures) {
+  SmeDotCandidate candidate;
+  auto lhsTy = dyn_cast<VectorType>(op.getA().getType());
+  auto rhsTy = dyn_cast<VectorType>(op.getB().getType());
+  auto accTy = dyn_cast<VectorType>(op.getC().getType());
+  auto resTy = dyn_cast<VectorType>(op.getType());
+  if (!lhsTy || !rhsTy || !accTy || !resTy) {
+    candidate.rejectReason = "non-vector dot operands";
+    return candidate;
+  }
+  candidate.lhsElemTy = lhsTy.getElementType();
+  candidate.rhsElemTy = rhsTy.getElementType();
+  candidate.accElemTy = accTy.getElementType();
+  if (lhsTy.getRank() != 2 || rhsTy.getRank() != 2 || resTy.getRank() != 2) {
+    candidate.rejectReason = "only rank-2 dot is considered by the SME prototype";
+    return candidate;
+  }
+  candidate.m = lhsTy.getDimSize(0);
+  candidate.k = lhsTy.getDimSize(1);
+  candidate.n = rhsTy.getDimSize(1);
+  if (rhsTy.getDimSize(0) != candidate.k) {
+    candidate.rejectReason = "lhs K does not match rhs K";
+    return candidate;
+  }
+  if (!isSupportedElemType(candidate.lhsElemTy) ||
+      !isSupportedElemType(candidate.rhsElemTy) ||
+      !isSupportedElemType(candidate.accElemTy)) {
+    candidate.rejectReason = "unsupported element type for SME prototype";
+    return candidate;
+  }
+  if (!hasFeature(targetFeatures, "sme") && !hasFeature(targetFeatures, "+sme") &&
+      !hasFeature(targetFeatures, "armv9-a")) {
+    candidate.rejectReason = "target features do not advertise SME; preserving fallback path";
+    return candidate;
+  }
+  candidate.supported = true;
+  return candidate;
+}
+
+struct ConvertDotToSME
+    : public triton::cpu::impl::ConvertDotToSMEBase<ConvertDotToSME> {
+  using ConvertDotToSMEBase::ConvertDotToSMEBase;
+
+  ConvertDotToSME() = default;
+
+  ConvertDotToSME(std::string features, bool diagnostics)
+      : ConvertDotToSMEBase() {
+    targetFeatures = features;
+    enableDiagnostics = diagnostics;
+  }
+
+  void runOnOperation() override {
+    ModuleOp mod = getOperation();
+    int64_t candidates = 0;
+    int64_t supported = 0;
+    mod.walk([&](cpu::DotOp op) {
+      ++candidates;
+      SmeDotCandidate candidate = classify(op, targetFeatures);
+      op->setAttr("triton_cpu.sme_gemm_candidate",
+                  buildGemmMetadata(op, candidate));
+      appendDiagnosticEvent(candidates - 1, candidate, targetFeatures);
+      if (candidate.supported)
+        ++supported;
+      if (enableDiagnostics) {
+        InFlightDiagnostic diag = op.emitRemark();
+        diag << "ARMv9 SME dot candidate m=" << candidate.m
+             << " n=" << candidate.n << " k=" << candidate.k
+             << " selected_path="
+             << (candidate.supported
+                     ? (llvm::StringRef(envOrEmpty("TRITON_CPU_ARMV9_ENABLE_SELECTED_HOOK")) == "1"
+                            ? "sme-hook-selected"
+                            : "sme-prototype")
+                     : "fallback");
+        if (!candidate.supported)
+          diag << " reject_reason=" << candidate.rejectReason;
+      }
+    });
+    if (enableDiagnostics) {
+      mod.emitRemark() << "ARMv9 SME dot pass inspected " << candidates
+                       << " dot op(s), " << supported
+                       << " candidate(s) marked for future SME lowering";
+    }
+  }
+};
+
