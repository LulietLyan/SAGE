+struct BrgemmTileMetadata {
+  std::optional<Value> tileId;
+  std::optional<Value> numTilesN;
+};
+
+static Value ensureIndexType(Value val, Location loc,
+                             PatternRewriter &rewriter) {
+  if (val.getType().isIndex())
+    return val;
+  return arith::IndexCastOp::create(rewriter, loc, rewriter.getIndexType(), val);
+}
+
+static Value clampActiveExtent(Location loc, Value full, Value tileOffset,
+                               int64_t blockExtent,
+                               PatternRewriter &rewriter) {
+  full = ensureIndexType(full, loc, rewriter);
+  tileOffset = ensureIndexType(tileOffset, loc, rewriter);
+  Value zero = arith::ConstantIndexOp::create(rewriter, loc, 0);
+  Value block =
+      arith::ConstantIndexOp::create(rewriter, loc, blockExtent);
+  Value remaining = arith::SubIOp::create(rewriter, loc, full, tileOffset);
+  remaining = arith::MaxSIOp::create(rewriter, loc, remaining, zero);
+  return arith::MinSIOp::create(rewriter, loc, remaining, block);
+}
+
+static Value missingIndexMeta(Location loc, PatternRewriter &rewriter) {
+  Value minusOne =
+      arith::ConstantIntOp::create(rewriter, loc, rewriter.getI64Type(), -1);
+  return arith::IndexCastOp::create(rewriter, loc, rewriter.getIndexType(),
+                                    minusOne);
+}
+
+static Value tileMetaIndexOrMissing(Location loc, PatternRewriter &rewriter,
+                                    std::optional<Value> val) {
+  if (!val)
+    return missingIndexMeta(loc, rewriter);
+  return ensureIndexType(*val, loc, rewriter);
+}
+
+static BrgemmTileMetadata gatherBrgemmTileMetadata(Operation *anchor) {
+  BrgemmTileMetadata meta;
+  auto func = anchor->getParentOfType<triton::FuncOp>();
+  if (!func)
+    return meta;
+
+  func.walk([&](triton::GetProgramIdOp pidOp) {
+    if (pidOp.getAxis() != triton::ProgramIDDim::X)
+      return;
+    meta.tileId = pidOp.getResult();
+  });
+
+  func.walk([&](arith::DivSIOp divOp) {
+    if (meta.numTilesN.has_value())
+      return;
+    Value lhs = divOp.getLhs();
+    if (auto castOp = lhs.getDefiningOp<arith::IndexCastOp>())
+      lhs = castOp.getIn();
+    if (!lhs.getDefiningOp<triton::GetProgramIdOp>())
+      return;
+    if (!getConstantIntValue(divOp.getRhs()))
+      return;
+    meta.numTilesN = divOp.getRhs();
+  });
+
+  return meta;
+}
+
+static Value createBrgemmKernel(PatternRewriter &rewriter, Location loc,
+                                Value blockM, Value blockN, Value blockK,
+                                Value numBatches, Value lda, Value ldb,
+                                Value ldc, Value stepA, Value stepB,
+                                Type dtypeA, Type dtypeB, Type resElemTy,
+                                Value skipPack, Value zeroAccumulator,
+                                Value nativeSME,
+                                const BrgemmTileMetadata &meta,
+                                Value fullM = {}, Value fullN = {}) {
+  Value missing = missingIndexMeta(loc, rewriter);
+  fullM = fullM ? ensureIndexType(fullM, loc, rewriter) : missing;
+  fullN = fullN ? ensureIndexType(fullN, loc, rewriter) : missing;
+  auto created = triton::cpu::BrgemmCreate::create(
+      rewriter, loc, rewriter.getIndexType(), blockM, blockN, blockK,
+      numBatches, lda, ldb, ldc, stepA, stepB, dtypeA, dtypeB, resElemTy,
+      skipPack, fullM, fullN,
+      tileMetaIndexOrMissing(loc, rewriter, meta.numTilesN), zeroAccumulator,
+      nativeSME);
+  copyReusePlan(created, rewriter.getInsertionBlock()->getParentOp());
+  return created;
+}
+
+static void createBrgemmInvoke(PatternRewriter &rewriter, Location loc,
+                               Value brgemm, Value lhs, Value rhs, Value acc,
+                               Value stepA, Value stepB, Value blockedB,
+                               Value numBatches, Value skipPack,
+                               Value blockM, Value blockN, Value blockK,
+                               Value lda, Value ldb, Value ldc,
+                               Value activeM, Value activeN, Value activeK,
+                               Value zeroAccumulator, Value nativeSME,
+                               const BrgemmTileMetadata &meta) {
+  auto created = triton::cpu::BrgemmExecute::create(
+      rewriter, loc, brgemm, lhs, rhs, acc, stepA, stepB, blockedB, numBatches,
+      skipPack, tileMetaIndexOrMissing(loc, rewriter, meta.tileId), blockM,
+      blockN, blockK, lda, ldb, ldc, activeM, activeN, activeK,
+      zeroAccumulator, nativeSME);
+  copyReusePlan(created, rewriter.getInsertionBlock()->getParentOp());
+}
+
+static bool isKnownZeroValue(Value value) {
+  if (matchPattern(value, m_Zero()))
+    return true;
+
+  Operation *def = value.getDefiningOp();
+  if (!def)
+    return false;
+
+  if (auto constant = dyn_cast<arith::ConstantOp>(def)) {
+    auto dense = dyn_cast<DenseElementsAttr>(constant.getValue());
+    if (!dense || !dense.isSplat())
+      return false;
+    Attribute splat = dense.getSplatValue<Attribute>();
+    if (auto floatAttr = dyn_cast<FloatAttr>(splat))
+      return floatAttr.getValue().isZero();
+    if (auto intAttr = dyn_cast<IntegerAttr>(splat))
+      return intAttr.getValue().isZero();
+    return false;
+  }
+
+  StringRef name = def->getName().getStringRef();
+  if (name == "vector.from_elements" || name == "vector.splat" ||
+      name == "vector.broadcast" || name == "vector.shape_cast")
+    return !def->getOperands().empty() &&
+           llvm::all_of(def->getOperands(), isKnownZeroValue);
+
+  return false;
+}
+
+static bool hasZeroInitialAccumulator(triton::cpu::DotOp op) {
+  Value init = op.getC();
+  if (isLoopCarriedAcc(init))
+    init = getInitAccValue(init);
+  return isKnownZeroValue(init);
+}
+
+static std::optional<PointerBatchPanels> analyzeNativePointerPanels(
+    triton::cpu::DotOp op, scf::ForOp forOp, int64_t blockM, int64_t blockN,
+    int64_t blockK) {
+  if (!hasCompilerPlan(op))
+    return analyzePointerBatchPanels(op, forOp, blockM, blockN, blockK);
+
+  // The early semantic pass proved a complete masked contiguous GEMM before
+  // scalarization. Its static dimensions replace the legacy requirement for
+  // runtime arguments literally named M/N/K; they are not inferred from late
+  // vector sizes. Recheck the shape, stride, block and launcher contract here.
+  auto selected = inheritedPlanInt(op, "sme_plan.selected_sme");
+  auto verified = inheritedPlanInt(op, "sme_plan.verified");
+  auto m = inheritedPlanInt(op, "sme_plan.m");
+  auto n = inheritedPlanInt(op, "sme_plan.n");
+  auto k = inheritedPlanInt(op, "sme_plan.k");
+  if (!selected || *selected != 1 || !verified || *verified != 1 ||
+      !m || !n || !k || *m <= 0 || *n <= 0 || *k <= 0 ||
+      inheritedPlanInt(op, "sme_plan.lda") != k ||
+      inheritedPlanInt(op, "sme_plan.ldb") != n ||
+      inheritedPlanInt(op, "sme_plan.ldc") != n ||
+      inheritedPlanInt(op, "sme_plan.block_m") != blockM ||
+      inheritedPlanInt(op, "sme_plan.block_n") != blockN ||
+      inheritedPlanInt(op, "sme_plan.block_k") != blockK ||
+      __int128(*m) * *k > INT32_MAX || __int128(*k) * *n > INT32_MAX ||
+      __int128(*m) * *n > INT32_MAX)
+    return std::nullopt;
+  int64_t numM = (*m + blockM - 1) / blockM;
+  int64_t numN = (*n + blockN - 1) / blockN;
+  auto lower = getConstantIntValue(forOp.getLowerBound());
+  auto upper = getConstantIntValue(forOp.getUpperBound());
+  if (!lower || *lower != 0 || !upper || *upper < *k || *upper % blockK != 0)
+    return std::nullopt;
+  if (inheritedPlanInt(op, "sme_plan.grid_x") != numM * numN ||
+      inheritedPlanInt(op, "sme_plan.grid_y") != 1 ||
+      inheritedPlanInt(op, "sme_plan.grid_z") != 1)
+    return std::nullopt;
+  auto func = forOp->getParentOfType<triton::FuncOp>();
+  if (!func || func.getNumArguments() != 3)
+    return std::nullopt;
+  for (Value arg : func.getArguments())
+    if (!isa<triton::PointerType>(arg.getType()))
+      return std::nullopt;
+  SmallVector<Value> pids;
+  bool unsupportedAxis = false;
+  func.walk([&](triton::GetProgramIdOp pid) {
+    if (pid.getAxis() == triton::ProgramIDDim::X)
+      pids.push_back(pid.getResult());
+    else
+      unsupportedAxis = true;
+  });
+  if (unsupportedAxis || pids.size() != 1)
+    return std::nullopt;
+  OpBuilder builder(forOp);
+  Location loc = forOp.getLoc();
+  auto constant = [&](int64_t value) -> Value {
+    return arith::ConstantIndexOp::create(builder, loc, value);
+  };
+  Value pid = arith::IndexCastOp::create(builder, loc, builder.getIndexType(),
+                                        pids.front());
+  Value numTilesN = constant(numN);
+  Value pidM = arith::DivUIOp::create(builder, loc, pid, numTilesN);
+  Value pidN = arith::RemUIOp::create(builder, loc, pid, numTilesN);
+  PointerBatchPanels info;
+  info.aRowBasePtr = func.getArgument(0);
+  info.bGlobalPtr = func.getArgument(1);
+  info.aTileRowOffset = arith::MulIOp::create(builder, loc, pidM, constant(blockM));
+  info.bColOffset = arith::MulIOp::create(builder, loc, pidN, constant(blockN));
+  info.kOffset = forOp.getInductionVar();
+  info.fullM = constant(*m);
+  info.fullN = constant(*n);
+  info.fullK = constant(*k);
+  info.pidM = pidM;
+  info.pidN = pidN;
+  info.numTilesN = numTilesN;
+  info.lda = *k;
+  info.ldb = *n;
+  return info;
+}
+
+static bool isProvenNativeSMECandidate(DotOpCandidate &candidate) {
+  if (candidate.blockM <= 0 || candidate.blockN <= 0 ||
+      candidate.blockK <= 0 ||
+      !candidate.isAccLoopCarried)
+    return false;
+
+  triton::cpu::DotOp op = candidate.op;
+  scf::ForOp forOp = getParentKLoopForDot(op);
+  if (!forOp || !isSupportedKLoopStep(forOp, candidate.blockK) ||
+      !hasZeroInitialAccumulator(op))
+    return false;
+
+  std::optional<int64_t> lower = getConstantIntValue(forOp.getLowerBound());
+  std::optional<int64_t> upper = getConstantIntValue(forOp.getUpperBound());
+  if (!lower || !upper || *lower != 0 || *upper <= *lower ||
+      (*upper - *lower) % candidate.blockK != 0)
+    return false;
+
+  auto panels = analyzeNativePointerPanels(op, forOp, candidate.blockM,
+                                          candidate.blockN,
+                                          candidate.blockK);
+  if (!panels)
+    return false;
+
+  auto accArg = dyn_cast<BlockArgument>(op.getC());
+  if (!accArg)
+    return false;
+  unsigned argNumber = accArg.getArgNumber();
+  unsigned numIvs = forOp.getNumInductionVars();
+  if (argNumber < numIvs)
+    return false;
+  unsigned resultIndex = argNumber - numIvs;
+  if (resultIndex >= forOp.getNumResults())
+    return false;
+
+  return findDirectOutputTile(forOp, resultIndex, candidate.blockM,
+                              candidate.blockN, panels->fullN)
+      .has_value();
+}
+
+static Value stripIndexCasts(Value val) {
+  while (auto castOp = dyn_cast_if_present<arith::IndexCastOp>(
+             val.getDefiningOp()))
+    val = castOp.getIn();
+  return val;
+}
+
+static bool valueEquals(Value a, Value b) {
+  return stripIndexCasts(a) == stripIndexCasts(b);
+}
+
+static Value materializeOffsetAtLb(Value offset, Value iv, Value lb,
+                                   Location loc, PatternRewriter &rewriter) {
+  if (valueEquals(offset, iv))
+    return lb;
+
+  if (auto mul = offset.getDefiningOp<arith::MulIOp>()) {
+    if (valueEquals(mul.getLhs(), iv))
+      return arith::MulIOp::create(rewriter, loc, lb, mul.getRhs());
+    if (valueEquals(mul.getRhs(), iv))
+      return arith::MulIOp::create(rewriter, loc, mul.getLhs(), lb);
+
+    Value lhs = mul.getLhs();
+    if (auto add = lhs.getDefiningOp<arith::AddIOp>()) {
+      Value lbAdj;
+      if (valueEquals(add.getLhs(), iv))
+        lbAdj = arith::AddIOp::create(rewriter, loc, lb, add.getRhs());
+      else if (valueEquals(add.getRhs(), iv))
+        lbAdj = arith::AddIOp::create(rewriter, loc, add.getLhs(), lb);
+      else
+        return nullptr;
+      return arith::MulIOp::create(rewriter, loc, lbAdj, mul.getRhs());
+    }
+  }
+
+  if (auto add = offset.getDefiningOp<arith::AddIOp>()) {
+    if (valueEquals(add.getLhs(), iv))
+      return arith::AddIOp::create(rewriter, loc, lb, add.getRhs());
+    if (valueEquals(add.getRhs(), iv))
+      return arith::AddIOp::create(rewriter, loc, add.getLhs(), lb);
+  }
+
+  return nullptr;
+}
+
+static Value castToPtrOffsetType(Value val, Value ref, Location loc,
+                                 PatternRewriter &rewriter) {
+  Type targetTy = ref.getType();
+  if (val.getType() == targetTy)
+    return val;
+  if (targetTy.isIndex())
+    return arith::IndexCastOp::create(rewriter, loc, targetTy, val);
+  if (val.getType().isIndex()) {
+    Type offsetTy =
+        isa<triton::PointerType>(targetTy) ? rewriter.getI32Type() : targetTy;
+    return arith::IndexCastOp::create(rewriter, loc, offsetTy, val);
+  }
+  return val;
+}
+
+static Value buildPointerBatchMemref(PatternRewriter &rewriter, Location loc,
+                                     Value ttPtr, ArrayRef<int64_t> shape,
+                                     Value rowStride, Type elemTy,
+                                     int64_t rowWidth) {
+  auto layout = StridedLayoutAttr::get(
+      rewriter.getContext(), ShapedType::kDynamic,
+      SmallVector<int64_t>{ShapedType::kDynamic, 1});
+  auto panelTy = MemRefType::get(
+      SmallVector<int64_t>(shape.begin(), shape.end()), elemTy, layout);
+  auto rowMemRefTy = MemRefType::get({rowWidth}, elemTy);
+  Value rowMem =
+      triton::cpu::PtrToMemRefOp::create(rewriter, loc, rowMemRefTy, ttPtr);
+  auto meta =
+      memref::ExtractStridedMetadataOp::create(rewriter, loc, rowMem);
+  return memref::ReinterpretCastOp::create(
+      rewriter, loc, panelTy, meta.getBaseBuffer(), meta.getOffset(),
+      ArrayRef<OpFoldResult>{rewriter.getIndexAttr(shape[0]),
+                             rewriter.getIndexAttr(shape[1])},
+      ArrayRef<OpFoldResult>{getAsOpFoldResult(rowStride),
+                             rewriter.getIndexAttr(1)});
+}
+
+static void zeroTileMemref(Location loc, Value tile, int64_t rows, int64_t cols,
+                           PatternRewriter &rewriter) {
+  Value zero = arith::ConstantIndexOp::create(rewriter, loc, 0);
+  Value one = arith::ConstantIndexOp::create(rewriter, loc, 1);
+  Value rowEnd = arith::ConstantIndexOp::create(rewriter, loc, rows);
+  Value colEnd = arith::ConstantIndexOp::create(rewriter, loc, cols);
+  Type elemTy = cast<MemRefType>(tile.getType()).getElementType();
+  Value zeroValue =
+      arith::ConstantOp::create(rewriter, loc, rewriter.getZeroAttr(elemTy));
+
+  auto rowLoop = scf::ForOp::create(rewriter, loc, zero, rowEnd, one);
+  {
+    OpBuilder::InsertionGuard guard(rewriter);
+    rewriter.setInsertionPointToStart(rowLoop.getBody());
+    Value i = rowLoop.getInductionVar();
+    auto colLoop = scf::ForOp::create(rewriter, loc, zero, colEnd, one);
+    rewriter.setInsertionPointToStart(colLoop.getBody());
+    Value j = colLoop.getInductionVar();
+    memref::StoreOp::create(rewriter, loc, zeroValue, tile, ValueRange{i, j});
+  }
+}
+
+// Caps the A-panel working set. Formal research used 4 MiB stack panels; larger
+// GEMMs can raise this and/or force heap allocation via env.
+static int64_t aPanelMaxMiB() {
+  const char *raw = std::getenv("TRITON_CPU_SME_A_PANEL_MAX_MIB");
+  if (!raw || !*raw)
+    return 4;
+  char *end = nullptr;
+  long value = std::strtol(raw, &end, 10);
+  if (end == raw || *end != '\0' || value < 1)
+    return 4;
+  return std::min<long>(value, 64);
+}
+
+static bool aPanelForceHeap() {
+  const char *raw = std::getenv("TRITON_CPU_SME_A_PANEL_HEAP");
+  if (!raw || !*raw)
+    return false;
+  return StringRef(raw) == "1" || StringRef(raw).equals_insensitive("true") ||
+         StringRef(raw).equals_insensitive("on") ||
+         StringRef(raw).equals_insensitive("yes");
+}
+
+// Optional NEON-width transpose packing; the packed layout and SME ABI stay
+// unchanged. Keep scalar packing as the default and for partial 4x4 blocks.
+static bool aPanelPackVector4Enabled(Operation *anchor) {
+  if (auto selected = inheritedPlanInt(anchor, "sme_plan.a_pack_vector4"))
+    return *selected != 0;
+  const char *raw = std::getenv("TRITON_CPU_SME_A_PACK_VECTOR4");
+  if (!raw || !*raw)
+    return false;
+  return StringRef(raw) == "1" || StringRef(raw).equals_insensitive("true") ||
+         StringRef(raw).equals_insensitive("on") ||
+         StringRef(raw).equals_insensitive("yes");
+}
+
+// Streaming K strips: 0/unset = auto (only when full panel exceeds MiB budget).
+// Positive N = force strips of N BLOCK_K batches when native SME can prove the path.
+static int64_t aPanelStreamKBatchesOverride(Operation *anchor, int64_t blockK) {
+  if (auto selected = inheritedPlanInt(anchor, "sme_plan.k_strip"))
+    return *selected / blockK;
+  const char *raw = std::getenv("TRITON_CPU_SME_A_STREAM_K_BATCHES");
+  if (!raw || !*raw)
+    return 0;
+  char *end = nullptr;
+  long value = std::strtol(raw, &end, 10);
+  if (end == raw || *end != '\0' || value < 0)
+    return 0;
+  return std::min<long>(value, 1 << 20);
+}
+
+static bool aPanelStreamEnabled(Operation *anchor) {
+  if (auto selected = inheritedPlanInt(anchor, "sme_plan.k_strip"))
+    return *selected > 0;
+  const char *raw = std::getenv("TRITON_CPU_SME_A_STREAM_K");
+  if (!raw || !*raw)
+    return true;
+  return StringRef(raw) == "1" || StringRef(raw).equals_insensitive("true") ||
+         StringRef(raw).equals_insensitive("on") ||
+         StringRef(raw).equals_insensitive("yes");
+}
+
+static int64_t aPanelMaxBatchesForBudget(int64_t blockM, int64_t blockK) {
+  int64_t bytesPerBatch = blockM * blockK * 4;
+  if (bytesPerBatch <= 0)
+    return 1;
+  int64_t maxBatches =
+      (aPanelMaxMiB() * 1024 * 1024) / bytesPerBatch;
+  return std::max<int64_t>(maxBatches, 1);
+}
+
+static void addTileMemrefs(Location loc, Value dst, Value src, int64_t rows,
+                           int64_t cols, PatternRewriter &rewriter) {
+  Value zero = arith::ConstantIndexOp::create(rewriter, loc, 0);
+  Value one = arith::ConstantIndexOp::create(rewriter, loc, 1);
+  Value rowEnd = arith::ConstantIndexOp::create(rewriter, loc, rows);
+  Value colEnd = arith::ConstantIndexOp::create(rewriter, loc, cols);
+  auto iLoop = scf::ForOp::create(rewriter, loc, zero, rowEnd, one);
+  {
+    OpBuilder::InsertionGuard guard(rewriter);
+    rewriter.setInsertionPointToStart(iLoop.getBody());
+    Value i = iLoop.getInductionVar();
+    auto jLoop = scf::ForOp::create(rewriter, loc, zero, colEnd, one);
+    rewriter.setInsertionPointToStart(jLoop.getBody());
+    Value j = jLoop.getInductionVar();
+    Value a = memref::LoadOp::create(rewriter, loc, dst, ValueRange{i, j});
+    Value b = memref::LoadOp::create(rewriter, loc, src, ValueRange{i, j});
+    Value sum = arith::AddFOp::create(rewriter, loc, a, b);
+    memref::StoreOp::create(rewriter, loc, sum, dst, ValueRange{i, j});
+  }
+}
+
+// Returns {panelMemRef, needsDealloc}. Uses heap when the panel exceeds the
+// configured MiB budget or TRITON_CPU_SME_A_PANEL_HEAP is set.
+// If existingPanel is non-null, pack into it (caller owns lifetime).
+static std::pair<Value, bool> materializeAPanelFromRowMajor(
+    Location loc, Value rowMajorPtr, Value numBatches, int64_t blockM,
+    int64_t blockK, Value lda, Value activeM, Value activeK, Type elemTy,
+    PatternRewriter &rewriter, Value existingPanel = {}) {
+  auto f32Ty = rewriter.getF32Type();
+  Value stackRows = op_muli(numBatches, index_cst(blockK));
+  auto stackTy = MemRefType::get({ShapedType::kDynamic, blockM}, f32Ty);
+  bool useHeap = false;
+  Value panel = existingPanel;
+  if (!panel) {
+    bool compilerPlan =
+        hasCompilerPlan(rewriter.getInsertionBlock()->getParentOp());
+    useHeap = !compilerPlan && aPanelForceHeap();
+    if (auto batches = getConstantIntValue(numBatches)) {
+      int64_t bytes = (*batches) * blockK * blockM * 4;
+      if (!compilerPlan && bytes > aPanelMaxMiB() * 1024 * 1024)
+        useHeap = true;
+    }
+    panel = useHeap ? memref::AllocOp::create(rewriter, loc, stackTy, stackRows)
+                          .getResult()
+                    : memref::AllocaOp::create(rewriter, loc, stackTy, stackRows)
+                          .getResult();
+  }
+  Value zero = arith::ConstantIndexOp::create(rewriter, loc, 0);
+  Value one = arith::ConstantIndexOp::create(rewriter, loc, 1);
+  Value rows = arith::ConstantIndexOp::create(rewriter, loc, blockM);
+  Value cols = arith::ConstantIndexOp::create(rewriter, loc, blockK);
+  Value batchElems = index_cst(blockK);
+  auto batchLoop = scf::ForOp::create(rewriter, loc, zero, numBatches, one);
+  {
+    OpBuilder::InsertionGuard guard(rewriter);
+    rewriter.setInsertionPointToStart(batchLoop.getBody());
+    Value batch = batchLoop.getInductionVar();
+    Value batchOff = arith::MulIOp::create(rewriter, loc, batch, batchElems);
+    Value batchPtr = triton::AddPtrOp::create(
+        rewriter, loc, rowMajorPtr.getType(), rowMajorPtr,
+        castToPtrOffsetType(batchOff, rowMajorPtr, loc, rewriter));
+    Value batchMem = buildPointerBatchMemref(
+        rewriter, loc, batchPtr, {blockM, blockK}, lda, elemTy, blockK);
+    Value rowBase = panelRowOffset(loc, batch, blockK, rewriter);
+    if (aPanelPackVector4Enabled(rewriter.getInsertionBlock()->getParentOp()) &&
+        blockM % 4 == 0 && blockK % 4 == 0) {
+      Value four = arith::ConstantIndexOp::create(rewriter, loc, 4);
+      Value three = arith::ConstantIndexOp::create(rewriter, loc, 3);
+      auto vecType = VectorType::get({4}, f32Ty);
+      auto iLoop = scf::ForOp::create(rewriter, loc, zero, rows, four);
+      rewriter.setInsertionPointToStart(iLoop.getBody());
+      Value i = iLoop.getInductionVar();
+      auto pLoop = scf::ForOp::create(rewriter, loc, zero, cols, four);
+      rewriter.setInsertionPointToStart(pLoop.getBody());
+      Value p = pLoop.getInductionVar();
+      Value lastRow = arith::AddIOp::create(rewriter, loc, i, three);
+      Value globalK = arith::AddIOp::create(rewriter, loc, batchOff, p);
+      Value lastK = arith::AddIOp::create(rewriter, loc, globalK, three);
+      Value inM = arith::CmpIOp::create(
+          rewriter, loc, arith::CmpIPredicate::ult, lastRow, activeM);
+      Value inK = arith::CmpIOp::create(
+          rewriter, loc, arith::CmpIPredicate::ult, lastK, activeK);
+      Value fullTile = arith::AndIOp::create(rewriter, loc, inM, inK);
+      scf::IfOp::create(
+          rewriter, loc, fullTile,
+          [&](OpBuilder &builder, Location nestedLoc) {
+            SmallVector<Value> loaded;
+            for (int64_t row = 0; row < 4; ++row) {
+              Value offset = arith::ConstantIndexOp::create(builder, nestedLoc,
+                                                          row);
+              Value inputRow =
+                  arith::AddIOp::create(builder, nestedLoc, i, offset);
+              loaded.push_back(vector::LoadOp::create(
+                  builder, nestedLoc, vecType, batchMem,
+                  ValueRange{inputRow, p}));
+            }
+            auto shuffle = [&](Value lhs, Value rhs,
+                               ArrayRef<int64_t> mask) -> Value {
+              return vector::ShuffleOp::create(builder, nestedLoc, lhs, rhs,
+                                               mask);
+            };
+            Value lo01 = shuffle(loaded[0], loaded[1], {0, 4, 1, 5});
+            Value hi01 = shuffle(loaded[0], loaded[1], {2, 6, 3, 7});
+            Value lo23 = shuffle(loaded[2], loaded[3], {0, 4, 1, 5});
+            Value hi23 = shuffle(loaded[2], loaded[3], {2, 6, 3, 7});
+            SmallVector<Value> columns{
+                shuffle(lo01, lo23, {0, 1, 4, 5}),
+                shuffle(lo01, lo23, {2, 3, 6, 7}),
+                shuffle(hi01, hi23, {0, 1, 4, 5}),
+                shuffle(hi01, hi23, {2, 3, 6, 7})};
+            Value packedBase =
+                arith::AddIOp::create(builder, nestedLoc, rowBase, p);
+            for (int64_t col = 0; col < 4; ++col) {
+              Value offset = arith::ConstantIndexOp::create(builder, nestedLoc,
+                                                          col);
+              Value packedRow = arith::AddIOp::create(
+                  builder, nestedLoc, packedBase, offset);
+              vector::StoreOp::create(builder, nestedLoc, columns[col], panel,
+                                      ValueRange{packedRow, i});
+            }
+            scf::YieldOp::create(builder, nestedLoc);
+          },
+          [&](OpBuilder &builder, Location nestedLoc) {
+            // Partial blocks keep the scalar load predicates. All packed
+            // entries are written, including zeros for inactive M/K lanes.
+            for (int64_t row = 0; row < 4; ++row) {
+              Value rowOffset = arith::ConstantIndexOp::create(
+                  builder, nestedLoc, row);
+              Value inputRow =
+                  arith::AddIOp::create(builder, nestedLoc, i, rowOffset);
+              Value rowValid = arith::CmpIOp::create(
+                  builder, nestedLoc, arith::CmpIPredicate::ult, inputRow,
+                  activeM);
+              for (int64_t col = 0; col < 4; ++col) {
+                Value colOffset = arith::ConstantIndexOp::create(
+                    builder, nestedLoc, col);
+                Value inputCol =
+                    arith::AddIOp::create(builder, nestedLoc, p, colOffset);
+                Value inputK = arith::AddIOp::create(
+                    builder, nestedLoc, batchOff, inputCol);
+                Value kValid = arith::CmpIOp::create(
+                    builder, nestedLoc, arith::CmpIPredicate::ult, inputK,
+                    activeK);
+                Value valid =
+                    arith::AndIOp::create(builder, nestedLoc, rowValid, kValid);
+                auto value = scf::IfOp::create(
+                    builder, nestedLoc, valid,
+                    [&](OpBuilder &tailBuilder, Location tailLoc) {
+                      Value loaded = memref::LoadOp::create(
+                          tailBuilder, tailLoc, batchMem,
+                          ValueRange{inputRow, inputCol});
+                      scf::YieldOp::create(tailBuilder, tailLoc, loaded);
+                    },
+                    [&](OpBuilder &tailBuilder, Location tailLoc) {
+                      Value zeroValue = arith::ConstantOp::create(
+                          tailBuilder, tailLoc,
+                          tailBuilder.getZeroAttr(elemTy));
+                      scf::YieldOp::create(tailBuilder, tailLoc, zeroValue);
+                    });
+                Value packedRow = arith::AddIOp::create(
+                    builder, nestedLoc, rowBase, inputCol);
+                memref::StoreOp::create(builder, nestedLoc, value.getResult(0),
+                                        panel, ValueRange{packedRow, inputRow});
+              }
+            }
+            scf::YieldOp::create(builder, nestedLoc);
+          });
+      return {panel, useHeap};
+    }
+    auto iLoop = scf::ForOp::create(rewriter, loc, zero, rows, one);
+    rewriter.setInsertionPointToStart(iLoop.getBody());
+    Value i = iLoop.getInductionVar();
+    auto pLoop = scf::ForOp::create(rewriter, loc, zero, cols, one);
+    rewriter.setInsertionPointToStart(pLoop.getBody());
+    Value p = pLoop.getInductionVar();
+    Value globalK = arith::AddIOp::create(rewriter, loc, batchOff, p);
+    Value inM = arith::CmpIOp::create(rewriter, loc,
+                                      arith::CmpIPredicate::ult, i, activeM);
+    Value inK = arith::CmpIOp::create(rewriter, loc,
+                                      arith::CmpIPredicate::ult, globalK,
+                                      activeK);
+    Value inBounds = arith::AndIOp::create(rewriter, loc, inM, inK);
+    auto ifOp = scf::IfOp::create(
+        rewriter, loc, inBounds,
+        [&](OpBuilder &builder, Location nestedLoc) {
+          Value loaded = memref::LoadOp::create(
+              builder, nestedLoc, batchMem, ValueRange{i, p});
+          scf::YieldOp::create(builder, nestedLoc, loaded);
+        },
+        [&](OpBuilder &builder, Location nestedLoc) {
+          Value zeroValue = arith::ConstantOp::create(
+              builder, nestedLoc, builder.getZeroAttr(elemTy));
+          scf::YieldOp::create(builder, nestedLoc, zeroValue);
+        });
+    Value val = ifOp.getResult(0);
+    Value storeRow = arith::AddIOp::create(rewriter, loc, rowBase, p);
+    memref::StoreOp::create(rewriter, loc, val, panel, ValueRange{storeRow, i});
+  }
+  return {panel, useHeap};
+}
+
+static Value materializeAPanelStackFromRowMajor(
+    Location loc, Value rowMajorPtr, Value numBatches, int64_t blockM,
+    int64_t blockK, Value lda, Value activeM, Value activeK, Type elemTy,
+    PatternRewriter &rewriter) {
+  return materializeAPanelFromRowMajor(loc, rowMajorPtr, numBatches, blockM,
+                                       blockK, lda, activeM, activeK, elemTy,
+                                       rewriter)
+      .first;
+}
+
+// A local B panel changes only its physical row stride. activeN remains the
+// logical width, and the SME helper writes directly to the original C. Copy
+// only active rows/columns: padded columns are never read by the helper's
+// predicates. The panel is refreshed for every strip of every invocation.
+static Value materializeBPanelFromRowMajor(
+    Location loc, Value rowMajorPtr, Value sourceLdb, Value activeK,
+    Value activeN, int64_t panelRows, int64_t blockN, Value panel,
+    PatternRewriter &rewriter) {
+  OpBuilder::InsertionGuard guard(rewriter);
+  auto f32Ty = rewriter.getF32Type();
+  auto vecTy = VectorType::get({4}, f32Ty);
+  Value source = buildPointerBatchMemref(
+      rewriter, loc, rowMajorPtr, {panelRows, blockN}, sourceLdb, f32Ty,
+      blockN);
+  Value zero = index_cst(0);
+  Value one = index_cst(1);
+  Value four = index_cst(4);
+  Value vectorColumns = arith::MulIOp::create(
+      rewriter, loc,
+      arith::DivUIOp::create(rewriter, loc, activeN, four), four);
+  auto rows = scf::ForOp::create(rewriter, loc, zero, activeK, one);
+  rewriter.setInsertionPointToStart(rows.getBody());
+  Value row = rows.getInductionVar();
+  auto vectors =
+      scf::ForOp::create(rewriter, loc, zero, vectorColumns, four);
+  {
+    OpBuilder::InsertionGuard vectorGuard(rewriter);
+    rewriter.setInsertionPointToStart(vectors.getBody());
+    Value col = vectors.getInductionVar();
+    Value loaded = vector::LoadOp::create(rewriter, loc, vecTy, source,
+                                         ValueRange{row, col});
+    vector::StoreOp::create(rewriter, loc, loaded, panel,
+                            ValueRange{row, col});
+  }
+  rewriter.setInsertionPointAfter(vectors);
+  auto tail =
+      scf::ForOp::create(rewriter, loc, vectorColumns, activeN, one);
+  rewriter.setInsertionPointToStart(tail.getBody());
+  Value col = tail.getInductionVar();
+  Value loaded =
+      memref::LoadOp::create(rewriter, loc, source, ValueRange{row, col});
+  memref::StoreOp::create(rewriter, loc, loaded, panel, ValueRange{row, col});
+  return panel;
+}
+
+static LogicalResult validateCompilerPlan(DotOpCandidate &candidate) {
+  Operation *op = candidate.op;
+  if (!hasCompilerPlan(op))
+    return success();
+  for (StringRef name : {"sme_plan.k_strip", "sme_plan.b_panel_pad",
+                         "sme_plan.a_pack_vector4", "sme_plan.reuse_m"}) {
+    if (!inheritedPlanInt(op, name))
+      return op->emitError("compiler SME plan requires integer/bool attribute ")
+             << name;
+  }
+  if (!isProvenNativeSMECandidate(candidate))
+    return op->emitError("compiler SME plan requires a proven native FP32 GEMM");
+  int64_t pad = *inheritedPlanInt(op, "sme_plan.b_panel_pad");
+  if (inheritedPlanAttr(op, "sme_plan.b_global_pad") &&
+      !inheritedPlanInt(op, "sme_plan.b_global_pad"))
+    return op->emitError("compiler global-B padding requires an integer attribute");
+  int64_t globalPad = inheritedPlanInt(op, "sme_plan.b_global_pad").value_or(0);
+  int64_t kc = *inheritedPlanInt(op, "sme_plan.k_strip");
+  int64_t pack = *inheritedPlanInt(op, "sme_plan.a_pack_vector4");
+  int64_t reuse = *inheritedPlanInt(op, "sme_plan.reuse_m");
+  if ((pad != 0 && pad != 16) || (globalPad != 0 && globalPad != 16) ||
+      (pad != 0 && globalPad != 0) || (pack != 0 && pack != 1) ||
+      reuse < 0 || reuse > 64 || kc < 0 || kc % candidate.blockK != 0)
+    return op->emitError("invalid compiler SME panel/packing/strip/reuse plan");
+  __int128 globalBBytes = 0;
+  if (globalPad) {
+    // The source proof remains ldb=N. Only the native entry consumes the
+    // launcher's padded B allocation; logical N and the original C stay intact.
+    int64_t n = *inheritedPlanInt(op, "sme_plan.n");
+    int64_t k = *inheritedPlanInt(op, "sme_plan.k");
+    globalBBytes = __int128(k) * (__int128(n) + globalPad) * 4;
+    if (globalBBytes > 256 * 1024 * 1024)
+      return op->emitError("compiler global-B workspace exceeds 256 MiB");
+  }
+
+  scf::ForOp loop = getParentKLoopForDot(candidate.op);
+  int64_t fullK = *getConstantIntValue(loop.getUpperBound());
+  int64_t rows = kc == 0 ? fullK : std::min(kc, fullK);
+  // Reserve an output tile conservatively although the native path stores C
+  // directly. Use wide arithmetic so malformed dimensions cannot wrap past
+  // the stack budget. No hidden environment setting may enlarge this budget.
+  __int128 aBytes = __int128(rows) * candidate.blockM * 4;
+  __int128 bBytes = pad ? __int128(rows) * (candidate.blockN + pad) * 4 : 0;
+  __int128 cReserve = __int128(candidate.blockM) * candidate.blockN * 4;
+  if (aBytes + bBytes + cReserve > 4 * 1024 * 1024)
+    return op->emitError("compiler SME A/B panels plus C reserve exceed 4 MiB");
+  if (auto func = op->getParentOfType<triton::FuncOp>()) {
+    Builder builder(op->getContext());
+    func->setAttr("sme_plan.panel_scratch_bytes",
+                  builder.getI64IntegerAttr(int64_t(aBytes + bBytes)));
+    func->setAttr("sme_plan.c_scratch_bytes", builder.getI64IntegerAttr(0));
+    func->setAttr("sme_plan.c_scratch_reserve_bytes",
+                  builder.getI64IntegerAttr(int64_t(cReserve)));
+    func->setAttr("sme_plan.scratch_guard_bytes",
+                  builder.getI64IntegerAttr(int64_t(aBytes + bBytes + cReserve)));
+    func->setAttr("sme_plan.b_panel_ldb",
+                  builder.getI64IntegerAttr(pad ? candidate.blockN + pad : 0));
+    func->setAttr("sme_plan.global_b_workspace_bytes",
+                  builder.getI64IntegerAttr(int64_t(globalBBytes)));
+    int64_t logicalN = *inheritedPlanInt(op, "sme_plan.n");
+    auto physicalLdb = builder.getI64IntegerAttr(
+        pad ? candidate.blockN + pad : logicalN + globalPad);
+    func->setAttr("sme_plan.physical_ldb", physicalLdb);
+    if (auto module = op->getParentOfType<ModuleOp>()) {
+      module->setAttr("sme_plan.physical_ldb", physicalLdb);
+      module->setAttr("sme_plan.global_b_workspace_bytes",
+                      builder.getI64IntegerAttr(int64_t(globalBBytes)));
+    }
+  }
+  return success();
+}
+
+static LogicalResult
+convertKLoopPointerBatchFusion(DotOpCandidate &candidate, Ukernels ukernels,
+                               PatternRewriter &rewriter) {
+  if (ukernels != Ukernels::SME || !kloopFusionEnabled() ||
+      !kloopPointerBatchEnabled())
+    return failure();
+
+  triton::cpu::DotOp op = candidate.op;
+  scf::ForOp forOp = getParentKLoopForDot(op);
+  if (!forOp || !candidate.isAccLoopCarried)
+    return failure();
+  if (!isSupportedKLoopStep(forOp, candidate.blockK))
+    return failure();
+
+  std::optional<PointerBatchPanels> panels = analyzeNativePointerPanels(
+      op, forOp, candidate.blockM, candidate.blockN, candidate.blockK);
+  if (!panels)
+    return failure();
+
+  Location loc = op.getLoc();
+  auto accArg = cast<BlockArgument>(op.getC());
+  int resIdx = accArg.getArgNumber() - forOp.getNumInductionVars();
+
+  OpBuilder::InsertionGuard guard(rewriter);
+  rewriter.setInsertionPoint(forOp);
+
+  std::optional<DirectOutputTile> directOut =
+      findDirectOutputTile(forOp, resIdx, candidate.blockM, candidate.blockN,
+                           panels->fullN);
+  const bool zeroInitialAccumulator = hasZeroInitialAccumulator(op);
+  const bool nativeSME = directOut && zeroInitialAccumulator && panels->fullM &&
+                         panels->fullN && panels->fullK;
+
+  // The strip decision below happens during this rewrite, before a later
+  // canonicalizer can fold arithmetic. Fold each step now so a static K loop
+  // really exposes a ConstantLike batch count to getConstantIntValue.
+  Value loopExtent = rewriter.createOrFold<arith::SubIOp>(
+      loc, forOp.getUpperBound(), forOp.getLowerBound());
+  Value numBatches = rewriter.createOrFold<arith::DivUIOp>(
+      loc, loopExtent, forOp.getStep());
+  if (!numBatches.getType().isIndex())
+    numBatches = rewriter.createOrFold<arith::IndexCastOp>(
+        loc, rewriter.getIndexType(), numBatches);
+
+  Value lb = forOp.getLowerBound();
+  Value iv = forOp.getInductionVar();
+  Value aRowBasePtr = panels->aRowBasePtr;
+  if (panels->aTileRowOffset) {
+    Value tileRowOffset =
+        ensureIndexType(panels->aTileRowOffset, loc, rewriter);
+    Value lda = ensureIndexType(panels->fullK, loc, rewriter);
+    Value tileOffset = arith::MulIOp::create(
+        rewriter, loc, tileRowOffset, lda);
+    Value ptrOffset =
+        castToPtrOffsetType(tileOffset, aRowBasePtr, loc, rewriter);
+    aRowBasePtr = triton::AddPtrOp::create(
+        rewriter, loc, aRowBasePtr.getType(), aRowBasePtr, ptrOffset);
+  }
+  Value aOff = castToPtrOffsetType(lb, aRowBasePtr, loc, rewriter);
+  Value aPtrAtLb = triton::AddPtrOp::create(
+      rewriter, loc, aRowBasePtr.getType(), aRowBasePtr, aOff);
+  Value kOffRaw =
+      materializeOffsetAtLb(panels->kOffset, iv, lb, loc, rewriter);
+  if (!kOffRaw)
+    return failure();
+  Value kOff = castToPtrOffsetType(kOffRaw, panels->bGlobalPtr, loc, rewriter);
+  Value bPtrAtK = triton::AddPtrOp::create(
+      rewriter, loc, panels->bGlobalPtr.getType(), panels->bGlobalPtr, kOff);
+  Value colOff =
+      castToPtrOffsetType(panels->bColOffset, bPtrAtK, loc, rewriter);
+  Value bPtrAtTile = triton::AddPtrOp::create(
+      rewriter, loc, bPtrAtK.getType(), bPtrAtK, colOff);
+
+  auto f32Ty = rewriter.getF32Type();
+  Value fullN = ensureIndexType(panels->fullN, loc, rewriter);
+  int64_t bGlobalPad = inheritedPlanInt(op, "sme_plan.b_global_pad").value_or(0);
+  Value sourceLdb = fullN;
+  if (bGlobalPad)
+    sourceLdb = arith::AddIOp::create(rewriter, loc, fullN, index_cst(bGlobalPad));
+  Value fullK = ensureIndexType(panels->fullK, loc, rewriter);
+  Value tileRowOffset = panels->aTileRowOffset
+                            ? ensureIndexType(panels->aTileRowOffset, loc,
+                                              rewriter)
+                            : arith::ConstantIndexOp::create(rewriter, loc, 0);
+  Value tileColOffset =
+      ensureIndexType(panels->bColOffset, loc, rewriter);
+  Value activeM = clampActiveExtent(loc, panels->fullM, tileRowOffset,
+                                    candidate.blockM, rewriter);
+  Value activeN = clampActiveExtent(loc, panels->fullN, tileColOffset,
+                                    candidate.blockN, rewriter);
+  Value activeK = ensureIndexType(panels->fullK, loc, rewriter);
+
+  MemBuffer accBuf;
+  if (!directOut) {
+    Operation *allocaPoint = op;
+    while (!isa<triton::FuncOp>(allocaPoint->getParentOp()))
+      allocaPoint = allocaPoint->getParentOp();
+    Value accInit = maybeCast(loc, getInitAccValue(op.getC()), f32Ty, rewriter);
+    accBuf = storeToTmpBuffer(loc, accInit, allocaPoint, rewriter);
+  }
+
+  if (directOut)
+    rewriter.setInsertionPointAfter(directOut->lastStore.getOperation());
+  else
+    rewriter.setInsertionPointAfter(forOp);
+
+  auto blockM = int_cst(rewriter.getI64Type(), candidate.blockM);
+  auto blockN = int_cst(rewriter.getI64Type(), candidate.blockN);
+  auto blockK = int_cst(rewriter.getI64Type(), candidate.blockK);
+
+  if (directOut) {
+    auto rowMeta = memref::ExtractStridedMetadataOp::create(
+        rewriter, loc, directOut->anchorStore.getBase());
+    Value ldc = directOut->ldc;
+    if (!ldc.getType().isIndex())
+      ldc = arith::IndexCastOp::create(rewriter, loc, rewriter.getIndexType(),
+                                       ldc);
+    auto cTileLayout = StridedLayoutAttr::get(
+        rewriter.getContext(), ShapedType::kDynamic,
+        SmallVector<int64_t>{ShapedType::kDynamic, 1});
+    auto cTileType = MemRefType::get({candidate.blockM, candidate.blockN},
+                                     f32Ty, cTileLayout);
+    Value cTile = memref::ReinterpretCastOp::create(
+        rewriter, loc, cTileType, rowMeta.getBaseBuffer(),
+        rowMeta.getOffset(),
+        ArrayRef<OpFoldResult>{rewriter.getIndexAttr(candidate.blockM),
+                              rewriter.getIndexAttr(candidate.blockN)},
+        ArrayRef<OpFoldResult>{getAsOpFoldResult(ldc),
+                               rewriter.getIndexAttr(1)});
+    if (!nativeSME)
+      zeroTileMemref(loc, cTile, candidate.blockM, candidate.blockN, rewriter);
+    accBuf = MemBuffer{cTile, {index_cst(0), index_cst(0)}};
+  }
+
+  int64_t elemBytes = sizeof(float);
+  Value lhsStepInBytes =
+      index_cst(candidate.blockM * candidate.blockK * elemBytes);
+  Value rhsStepInBytes =
+      op_muli(index_cst(candidate.blockK * elemBytes), sourceLdb);
+
+  auto dtypeA = op.getA().getType();
+  auto dtypeB = op.getB().getType();
+  auto skipPack = int_cst(rewriter.getI1Type(), true);
+  auto nativeSMEValue = int_cst(rewriter.getI1Type(), nativeSME);
+  BrgemmTileMetadata tileMeta = gatherBrgemmTileMetadata(op);
+
+  auto rhsTypeSize = int_cst(rewriter.getI64Type(),
+                             cast<VectorType>(dtypeB).getElementTypeBitWidth() /
+                                 8);
+  Value rhsBlockSizeInBytes = op_muli(op_muli(blockN, blockK), rhsTypeSize);
+
+  // Decide streaming strips. Native path can accumulate across strips via
+  // zeroAccumulator=0; fallback path keeps a single full panel.
+  std::optional<int64_t> constBatches = getConstantIntValue(numBatches);
+  int64_t budgetBatches =
+      aPanelMaxBatchesForBudget(candidate.blockM, candidate.blockK);
+  int64_t forcedBatches =
+      aPanelStreamKBatchesOverride(op, candidate.blockK);
+  int64_t stripBatches = 0;
+  if (nativeSME && aPanelStreamEnabled(op) && constBatches) {
+    if (forcedBatches > 0 && *constBatches > forcedBatches)
+      stripBatches = forcedBatches;
+    else if (forcedBatches == 0 && *constBatches > budgetBatches)
+      stripBatches = budgetBatches;
+  }
+
+  int64_t bPanelPad = inheritedPlanInt(op, "sme_plan.b_panel_pad").value_or(0);
+  int64_t bPanelRows = 0;
+  Value sharedBPanel;
+  if (bPanelPad) {
+    // validateCompilerPlan checked the static loop, native path and total
+    // scratch budget before any rewrite. Reuse one allocation across strips.
+    bPanelRows =
+        (stripBatches > 0 ? stripBatches : *constBatches) * candidate.blockK;
+    auto panelType = MemRefType::get(
+        {bPanelRows, candidate.blockN + bPanelPad}, f32Ty);
+    sharedBPanel = memref::AllocaOp::create(rewriter, loc, panelType);
+  }
+
+  auto emitOneStrip = [&](Value aPtrStrip, Value bPtrStrip, Value stripBatchCount,
+                          Value stripActiveK, Value zeroAccFlag, Value panel) {
+    Value lhsPanel = materializeAPanelFromRowMajor(
+                         loc, aPtrStrip, stripBatchCount, candidate.blockM,
+                         candidate.blockK, fullK, activeM, stripActiveK, f32Ty,
+                         rewriter, panel)
+                         .first;
+    Value rhsPanel = sharedBPanel
+        ? materializeBPanelFromRowMajor(
+              loc, bPtrStrip, sourceLdb, stripActiveK, activeN, bPanelRows,
+              candidate.blockN, sharedBPanel, rewriter)
+        : buildPointerBatchMemref(
+              rewriter, loc, bPtrStrip, {candidate.blockK, candidate.blockN},
+              sourceLdb, f32Ty, candidate.blockN);
+
+    auto metadataA =
+        memref::ExtractStridedMetadataOp::create(rewriter, loc, lhsPanel);
+    auto metadataB =
+        memref::ExtractStridedMetadataOp::create(rewriter, loc, rhsPanel);
+    auto metadataAcc =
+        memref::ExtractStridedMetadataOp::create(rewriter, loc, accBuf.memRef);
+
+    Value lda = metadataA.getStrides()[metadataA.getStrides().size() - 2];
+    Value ldb = metadataB.getStrides()[metadataB.getStrides().size() - 2];
+    Value ldc = metadataAcc.getStrides()[metadataAcc.getStrides().size() - 2];
+    Value actualRhsStep = sharedBPanel
+        ? index_cst(candidate.blockK * (candidate.blockN + bPanelPad) * 4)
+        : rhsStepInBytes;
+
+    Value brgemm = createBrgemmKernel(
+        rewriter, loc, blockM, blockN, blockK, stripBatchCount, lda, ldb, ldc,
+        lhsStepInBytes, actualRhsStep, dtypeA, dtypeB, f32Ty, skipPack,
+        zeroAccFlag, nativeSMEValue, tileMeta, panels->fullM, panels->fullN);
+
+    createBrgemmInvoke(rewriter, loc, brgemm, lhsPanel, rhsPanel, accBuf.memRef,
+                       lhsStepInBytes, actualRhsStep, rhsBlockSizeInBytes,
+                       stripBatchCount, skipPack, blockM, blockN, blockK, lda,
+                       ldb, ldc, activeM, activeN, stripActiveK, zeroAccFlag,
+                       nativeSMEValue, tileMeta);
+  };
+
+  if (stripBatches > 0) {
+    Value stackRows = index_cst(stripBatches * candidate.blockK);
+    auto stackTy =
+        MemRefType::get({ShapedType::kDynamic, candidate.blockM}, f32Ty);
+    int64_t stripBytes =
+        stripBatches * candidate.blockK * candidate.blockM * 4;
+    bool panelNeedsDealloc =
+        !hasCompilerPlan(op) &&
+        (aPanelForceHeap() || stripBytes > aPanelMaxMiB() * 1024 * 1024);
+    Value sharedPanel =
+        panelNeedsDealloc
+            ? memref::AllocOp::create(rewriter, loc, stackTy, stackRows)
+                  .getResult()
+            : memref::AllocaOp::create(rewriter, loc, stackTy, stackRows)
+                  .getResult();
+    for (int64_t start = 0; start < *constBatches; start += stripBatches) {
+      int64_t count =
+          std::min<int64_t>(stripBatches, *constBatches - start);
+      Value stripStart = index_cst(start);
+      Value stripCount = index_cst(count);
+      Value kElems =
+          arith::MulIOp::create(rewriter, loc, stripStart,
+                                index_cst(candidate.blockK));
+      Value aOffStrip =
+          castToPtrOffsetType(kElems, aPtrAtLb, loc, rewriter);
+      Value aPtrStrip = triton::AddPtrOp::create(
+          rewriter, loc, aPtrAtLb.getType(), aPtrAtLb, aOffStrip);
+      Value bKElems = arith::MulIOp::create(rewriter, loc, kElems, sourceLdb);
+      Value bOffStrip =
+          castToPtrOffsetType(bKElems, bPtrAtTile, loc, rewriter);
+      Value bPtrStrip = triton::AddPtrOp::create(
+          rewriter, loc, bPtrAtTile.getType(), bPtrAtTile, bOffStrip);
+      // K_PAD controls the static loop but true K may still be a runtime
+      // argument. Clamp every strip using true K, including a partial final
+      // strip and masked strips beyond K, before packing A or reading B.
+      Value stripActiveK = clampActiveExtent(
+          loc, activeK, kElems, count * candidate.blockK, rewriter);
+      Value zeroAccFlag =
+          int_cst(rewriter.getI1Type(), start == 0 && zeroInitialAccumulator);
+      emitOneStrip(aPtrStrip, bPtrStrip, stripCount, stripActiveK, zeroAccFlag,
+                   sharedPanel);
+    }
+    if (panelNeedsDealloc)
+      memref::DeallocOp::create(rewriter, loc, sharedPanel);
+  } else {
+    Value zeroAccumulator =
+        int_cst(rewriter.getI1Type(), zeroInitialAccumulator);
+    emitOneStrip(aPtrAtLb, bPtrAtTile, numBatches, activeK, zeroAccumulator,
+                 /*panel=*/{});
+  }
+
+  VectorType resultTy = cast<VectorType>(op.getResult().getType());
+  rewriter.replaceOp(op, op.getC());
+
+  if (directOut) {
+    for (Operation *epilogueOp : directOut->epilogueOps)
+      rewriter.eraseOp(epilogueOp);
+  } else if (forOp.getNumResults() > 0) {
+    Value newVal = op_read(cast<VectorType>(toFp32(resultTy)), accBuf.memRef,
+                           accBuf.indices);
+    newVal = maybeCast(loc, newVal, resultTy.getElementType(), rewriter);
+    rewriter.replaceAllUsesWith(forOp.getResult(resIdx), newVal);
+  }
+
+  if (!forOp.getOperation()->use_empty())
+    return failure();
+
+  rewriter.eraseOp(forOp);
+  return success();
+}
