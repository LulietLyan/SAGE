+// Describes global A/B panel bases for K-loop pointer-batch BRGEMM (S-B).
+struct PointerBatchPanels {
+  Value aRowBasePtr;
+  // Optional row offset, in elements, from aRowBasePtr to the program's A
+  // tile. This is kept separate so the rewrite can materialize rowOffset*lda.
+  Value aTileRowOffset;
+  Value bGlobalPtr;
+  Value bColOffset;
+  Value kOffset;
+  // Global execution-space values recovered from the program grid and the
+  // masked GEMM bounds. These are semantic extents, not local vector shapes.
+  Value fullM;
+  Value fullN;
+  Value fullK;
+  Value pidM;
+  Value pidN;
+  Value numTilesN;
+  int64_t lda = 0;
+  int64_t ldb = 0;
+};
+
+std::optional<PointerBatchPanels>
+analyzePointerBatchPanels(triton::cpu::DotOp op, scf::ForOp forOp,
+                          int64_t blockM, int64_t blockN, int64_t blockK);
+
